# Flutter / Dart tool cache (regenerated by flutter pub get)
.dart_tool/

# Build outputs (regenerated by flutter test, flutter run, flutter build)
build/

# Plugin resolution (regenerated by flutter pub get)
.flutter-plugins
.flutter-plugins-dependencies

# Legacy package resolution (if present)
.packages

# Android Gradle cache (regenerated locally)
android/.gradle/

# iOS / macOS ephemeral Flutter outputs (when those trees exist)
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
macos/Flutter/ephemeral/

# pubspec.lock is kept tracked for this app (not a published package).
