+import React, { useState } from "react";
+import { StudioCommand, StudioSession } from "../../lib/studio/studio.types";
+import { studioCopy } from "../../lib/studio/studio-copy";
+
+interface Props {
+  open: boolean;
+  session: StudioSession;
+  onSubmit: (raw: string) => void;
+}
+
+export const StudioCommandPanel: React.FC<Props> = ({ open, session, onSubmit }) => {
+  const [val, setVal] = useState("");
+  if (!open) return null;
+  return (
+    <div
+      style={{
+        position: "fixed",
+        right: 18,
+        bottom: 18,
+        width: 420,
+        maxHeight: "50vh",
+        background: "rgba(3,7,18,0.8)",
+        border: "1px solid rgba(255,255,255,0.04)",
+        padding: 12,
+        borderRadius: 12,
+        overflow: "auto",
+      }}
+    >
+      <div style={{ fontWeight: 700, marginBottom: 8 }}>Command Panel</div>
+      <div style={{ display: "flex", gap: 8, marginBottom: 8 }}>
+        <input
+          placeholder={studioCopy.placeholders.commandInput}
+          value={val}
+          onChange={(e) => setVal(e.target.value)}
+          style={{
+            flex: 1,
+            padding: "8px 10px",
+            borderRadius: 8,
+            border: "1px solid rgba(255,255,255,0.04)",
+            background: "transparent",
+            color: "inherit",
+          }}
+        />
+        <button
+          onClick={() => {
+            if (!val.trim()) return;
+            onSubmit(val.trim());
+            setVal("");
+          }}
+          style={{ padding: "8px 12px", borderRadius: 8, cursor: "pointer" }}
+        >
+          Send
+        </button>
+      </div>
+      <div style={{ fontSize: 13, color: "#9aa4b2", marginBottom: 6 }}>Recent</div>
+      <div style={{ display: "flex", flexDirection: "column", gap: 8 }}>
+        {session.commands.map((c: StudioCommand) => (
+          <div
+            key={c.id}
+            style={{
+              background: "rgba(255,255,255,0.02)",
+              padding: 8,
+              borderRadius: 8,
+              border: "1px solid rgba(255,255,255,0.02)",
+            }}
+          >
+            <div style={{ fontSize: 13, fontWeight: 600 }}>{c.raw}</div>
+            <div style={{ fontSize: 12, color: "#b6c0c8" }}>{c.previewText}</div>
+            <div style={{ fontSize: 11, color: "#9aa4b2", marginTop: 6 }}>{c.intent}</div>
+          </div>
+        ))}
+      </div>
+    </div>
+  );
+};
+
+export default StudioCommandPanel;
+
