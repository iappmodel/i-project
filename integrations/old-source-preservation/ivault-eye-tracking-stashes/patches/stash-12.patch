+import {
+  StudioState,
+  StudioSession,
+  StudioToolId,
+  StudioClip,
+  AspectRatio,
+} from "./studio.types";
+import { mockSession } from "./studio.mock";
+import { parseStudioCommand } from "./studio-commands";
+
+function cloneSession(s: StudioSession): StudioSession {
+  return JSON.parse(JSON.stringify(s)) as StudioSession;
+}
+
+export function createInitialStudioState(): StudioState {
+  const session = cloneSession(mockSession);
+  return {
+    activeSession: session,
+    selectedClipId: session.clips.length ? session.clips[0].id : null,
+    activeTool: "select",
+    isPlaying: false,
+    exportPanelOpen: false,
+    commandPanelOpen: false,
+  };
+}
+
+export function selectClip(state: StudioState, clipId: string): StudioState {
+  return {
+    ...state,
+    selectedClipId: clipId,
+    activeTool: state.activeTool,
+  };
+}
+
+export function toggleClipDiscarded(state: StudioState, clipId: string): StudioState {
+  const session = cloneSession(state.activeSession);
+  const clip = session.clips.find((c) => c.id === clipId);
+  if (!clip) return state;
+  clip.status = clip.status === "discarded" ? "raw" : "discarded";
+  session.updatedAt = new Date().toISOString();
+  return { ...state, activeSession: session, selectedClipId: clipId };
+}
+
+export function setAspectRatio(state: StudioState, aspectRatio: AspectRatio): StudioState {
+  const session = cloneSession(state.activeSession);
+  session.aspectRatio = aspectRatio;
+  session.updatedAt = new Date().toISOString();
+  return { ...state, activeSession: session };
+}
+
+export function addStudioCommand(state: StudioState, rawCommand: string): StudioState {
+  const session = cloneSession(state.activeSession);
+  const cmd = parseStudioCommand(rawCommand);
+  session.commands.unshift(cmd);
+  session.updatedAt = new Date().toISOString();
+  return { ...state, activeSession: session, commandPanelOpen: true };
+}
+
+export function setTargetDuration(state: StudioState, seconds?: number | null): StudioState {
+  const session = cloneSession(state.activeSession);
+  session.targetDurationSeconds = seconds ?? null;
+  session.updatedAt = new Date().toISOString();
+  return { ...state, activeSession: session };
+}
+
+export function calculateSessionStats(session: StudioSession) {
+  const clips = session.clips;
+  const totalRaw = clips.reduce((s, c) => s + c.durationSeconds, 0);
+  const avgQuality =
+    clips.length === 0 ? 0 : Math.round(clips.reduce((s, c) => s + c.qualityScore, 0) / clips.length);
+  // update basic derived fields (mutates shallow copy)
+  const updated = cloneSession(session);
+  updated.rawDurationSeconds = totalRaw;
+  if (updated.targetDurationSeconds == null) {
+    updated.estimatedFinalDurationSeconds = Math.min(60, Math.round(totalRaw * 0.1));
+  } else {
+    updated.estimatedFinalDurationSeconds = updated.targetDurationSeconds;
+  }
+  // naive storage estimate: 2 MB/s for video
+  updated.storageUsedMb = Math.max(1, Math.round(totalRaw * 2));
+  updated.recoverableStorageMb = Math.round(updated.storageUsedMb * 0.8);
+  updated.updatedAt = new Date().toISOString();
+  return { updated, stats: { totalRaw, avgQuality } };
+}
+
+export function setActiveTool(state: StudioState, tool: StudioToolId): StudioState {
+  return { ...state, activeTool: tool };
+}
+
