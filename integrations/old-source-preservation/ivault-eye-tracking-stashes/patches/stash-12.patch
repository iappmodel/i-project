+++ b/src/lib/studio/studio-commands.ts
@@ -0,0 +1,81 @@
+import { StudioCommand, CommandIntent, CommandStatus } from "./studio.types";
+
+function genId(prefix = "cmd-") {
+  return `${prefix}${Math.floor(Math.random() * 1e9).toString(36)}`;
+}
+
+function nowISO() {
+  return new Date().toISOString();
+}
+
+function normalize(raw: string) {
+  return raw.trim().toLowerCase();
+}
+
+export function parseStudioCommand(raw: string): StudioCommand {
+  const n = normalize(raw);
+
+  const intent: CommandIntent = detectIntent(n);
+
+  const previewText = mockedPreviewForIntent(intent, n);
+
+  const cmd: StudioCommand = {
+    id: genId(),
+    raw,
+    normalized: n,
+    intent,
+    status: "previewed",
+    createdAt: nowISO(),
+    previewText,
+  };
+
+  return cmd;
+}
+
+function detectIntent(n: string): CommandIntent {
+  // order matters: more specific first
+  if (/(45 seconds|45s|rough cut|best moments|cut|remove|trim|shorten)/.test(n)) {
+    return "edit_request";
+  }
+  if (/(skin|lighting|cinematic|romantic|action|beauty)/.test(n)) {
+    return "enhancement_request";
+  }
+  if (/(music|sound|audio|voice|noise)/.test(n)) {
+    return "audio_request";
+  }
+  if (/(post|feed|stories|campaign|publish|post to)/.test(n)) {
+    return "publish_request";
+  }
+  if (/(delete|storage|raw clips|cleanup|cleanup storage)/.test(n)) {
+    return "storage_request";
+  }
+  if (/(proof|originality|fingerprint|protect)/.test(n)) {
+    return "proof_request";
+  }
+  if (/(go|pause|resume|stop|mark)/.test(n)) {
+    return "capture_control";
+  }
+  return "unknown";
+}
+
+function mockedPreviewForIntent(intent: CommandIntent, raw: string): string {
+  switch (intent) {
+    case "edit_request":
+      return "Studio will generate a 45s rough cut using marked moments, highlight score, silence detection, and clip quality.";
+    case "enhancement_request":
+      return "Studio will prepare a non-destructive visual enhancement layer. Original media remains protected.";
+    case "audio_request":
+      return "Studio will analyze audio tracks and propose mixing, noise reduction, and music beds.";
+    case "publish_request":
+      return "Studio will prepare feed, story, and campaign-safe publishing options.";
+    case "storage_request":
+      return "Studio found recoverable raw media. Deletion will require explicit confirmation.";
+    case "proof_request":
+      return "Studio will prepare originality fingerprinting and custody metadata.";
+    case "capture_control":
+      return "Capture control command parsed. (mock) — will affect recording state when live.";
+    default:
+      return `Studio could not confidently parse intent for: "${raw}".`;
+  }
+}
+
