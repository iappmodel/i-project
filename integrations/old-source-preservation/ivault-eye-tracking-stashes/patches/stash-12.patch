+import React from "react";
+import { StudioTimeline, TimelineItem } from "../../lib/studio/studio.types";
+
+interface Props {
+  timeline: StudioTimeline;
+  onSeek?: (seconds: number) => void;
+}
+
+export const StudioTimeline: React.FC<Props> = ({ timeline, onSeek }) => {
+  const width = 800;
+  const duration = Math.max(1, timeline.durationSeconds);
+  return (
+    <div style={{ padding: 12 }}>
+      <div style={{ color: "#9aa4b2", marginBottom: 8 }}>Timeline</div>
+      <div style={{ background: "rgba(255,255,255,0.02)", padding: 12, borderRadius: 8 }}>
+        <div style={{ position: "relative", height: 120 }}>
+          {/* ruler */}
+          <div style={{ height: 24, color: "#9aa4b2", fontSize: 12 }}>
+            {Array.from({ length: 6 }).map((_, i) => {
+              const t = Math.round((i * duration) / 5);
+              return (
+                <span key={i} style={{ display: "inline-block", width: width / 5, textAlign: "center" }}>
+                  {t}s
+                </span>
+              );
+            })}
+          </div>
+          {/* layers */}
+          <div style={{ display: "flex", gap: 6, marginTop: 8, flexDirection: "column" }}>
+            {timeline.layers.map((layer) => (
+              <div key={layer.id} style={{ background: "rgba(0,0,0,0.25)", padding: 8, borderRadius: 6 }}>
+                <div style={{ fontSize: 12, color: "#b6c0c8", marginBottom: 6 }}>{layer.name}</div>
+                <div style={{ position: "relative", height: 28, background: "rgba(255,255,255,0.01)", borderRadius: 4 }}>
+                  {layer.items.map((it) => (
+                    <TimelineBlock key={it.id} item={it} duration={duration} totalWidth={width} onSeek={onSeek} />
+                  ))}
+                  {/* playhead */}
+                  <div
+                    style={{
+                      position: "absolute",
+                      left: `${(timeline.playheadSeconds / duration) * 100}%`,
+                      top: 0,
+                      bottom: 0,
+                      width: 2,
+                      background: "rgba(255,255,255,0.6)",
+                    }}
+                  />
+                </div>
+              </div>
+            ))}
+          </div>
+        </div>
+      </div>
+    </div>
+  );
+};
+
+const TimelineBlock: React.FC<{ item: TimelineItem; duration: number; totalWidth: number; onSeek?: (s: number) => void }> = ({
+  item,
+  duration,
+  totalWidth,
+  onSeek,
+}) => {
+  const left = (item.startSeconds / duration) * 100;
+  const width = (item.durationSeconds / duration) * 100;
+  return (
+    <div
+      onClick={() => onSeek?.(item.startSeconds)}
+      title={item.label}
+      style={{
+        position: "absolute",
+        left: `${left}%`,
+        width: `${width}%`,
+        top: 2,
+        bottom: 2,
+        background: "linear-gradient(90deg,#334155,#0f172a)",
+        borderRadius: 4,
+        border: "1px solid rgba(255,255,255,0.04)",
+        padding: "2px 6px",
+        fontSize: 12,
+        color: "#fff",
+        display: "flex",
+        alignItems: "center",
+        gap: 8,
+      }}
+    >
+      {item.label}
+    </div>
+  );
+};
+
+export default StudioTimeline;
+
