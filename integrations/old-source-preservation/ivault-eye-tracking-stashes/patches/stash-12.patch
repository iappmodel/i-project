@@ -0,0 +1,60 @@
+import React from "react";
+import { StudioClip } from "../../lib/studio/studio.types";
+
+interface Props {
+  clips: StudioClip[];
+  selectedClipId?: string | null;
+  onSelect: (id: string) => void;
+  onToggleDiscard?: (id: string) => void;
+}
+
+export const StudioClipStrip: React.FC<Props> = ({ clips, selectedClipId, onSelect, onToggleDiscard }) => {
+  return (
+    <div style={{ display: "flex", gap: 8, overflowX: "auto", padding: 8 }}>
+      {clips.map((c) => (
+        <div
+          key={c.id}
+          onClick={() => onSelect(c.id)}
+          style={{
+            minWidth: 140,
+            minHeight: 80,
+            borderRadius: 8,
+            padding: 8,
+            cursor: "pointer",
+            border: selectedClipId === c.id ? "2px solid #60a5fa" : "1px solid rgba(255,255,255,0.03)",
+            background: c.thumbnailGradient,
+            display: "flex",
+            flexDirection: "column",
+            justifyContent: "space-between",
+          }}
+        >
+          <div style={{ fontWeight: 700 }}>{c.title}</div>
+          <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center" }}>
+            <div style={{ fontSize: 12, color: "#d6dbe2" }}>{c.durationSeconds}s</div>
+            <div style={{ display: "flex", gap: 6 }}>
+              <MiniBadge>{c.qualityScore}</MiniBadge>
+              <MiniBadge>{c.highlightScore}</MiniBadge>
+              {c.isMarked ? <MiniBadge>★</MiniBadge> : null}
+              <button
+                onClick={(e) => {
+                  e.stopPropagation();
+                  onToggleDiscard?.(c.id);
+                }}
+                style={{ background: "transparent", border: "none", color: "inherit", cursor: "pointer" }}
+              >
+                {c.status === "discarded" ? "↺" : "🗑"}
+              </button>
+            </div>
+          </div>
+        </div>
+      ))}
+    </div>
+  );
+};
+
+const MiniBadge: React.FC<React.PropsWithChildren<{}>> = ({ children }) => (
+  <div style={{ background: "rgba(0,0,0,0.35)", padding: "2px 6px", borderRadius: 6, fontSize: 12 }}>{children}</div>
+);
+
+export default StudioClipStrip;
+
