+import React from "react";
+import { StudioSession, StudioClip } from "../../lib/studio/studio.types";
+
+interface Props {
+  session: StudioSession;
+  selectedClip?: StudioClip | null;
+  onToggleDiscard?: (clipId: string) => void;
+}
+
+export const StudioSessionPanel: React.FC<Props> = ({ session, selectedClip, onToggleDiscard }) => {
+  return (
+    <div style={{ width: 300, padding: 12, borderLeft: "1px solid rgba(255,255,255,0.03)" }}>
+      <div style={{ fontSize: 14, fontWeight: 700, marginBottom: 8 }}>{session.title}</div>
+      <div style={{ fontSize: 13, color: "#9aa4b2", marginBottom: 12 }}>
+        Status: {session.status} • Clips: {session.clips.length}
+      </div>
+      <div style={{ marginBottom: 12 }}>
+        <Stat label="Raw time" value={`${Math.round(session.rawDurationSeconds)}s`} />
+        <Stat label="Target" value={session.targetDurationSeconds ? `${session.targetDurationSeconds}s` : "—"} />
+        <Stat label="Storage" value={`${session.storageUsedMb} MB`} />
+        <Stat label="Recoverable" value={`${session.recoverableStorageMb} MB`} />
+      </div>
+      <div style={{ fontWeight: 700, marginBottom: 8 }}>Selected clip</div>
+      {selectedClip ? (
+        <div style={{ background: "rgba(255,255,255,0.02)", padding: 8, borderRadius: 8 }}>
+          <div style={{ fontWeight: 700 }}>{selectedClip.title}</div>
+          <div style={{ fontSize: 12, color: "#9aa4b2" }}>{selectedClip.durationSeconds}s</div>
+          <div style={{ marginTop: 8 }}>
+            <button
+              onClick={() => onToggleDiscard?.(selectedClip.id)}
+              style={{ padding: "6px 10px", borderRadius: 8, cursor: "pointer" }}
+            >
+              {selectedClip.status === "discarded" ? "Undiscard" : "Discard"}
+            </button>
+          </div>
+        </div>
+      ) : (
+        <div style={{ color: "#9aa4b2" }}>No clip selected</div>
+      )}
+      <div style={{ marginTop: 14 }}>
+        <div style={{ fontWeight: 700, marginBottom: 8 }}>Proof & Storage</div>
+        <div style={{ background: "rgba(255,255,255,0.02)", padding: 8, borderRadius: 8 }}>
+          <div style={{ fontSize: 13 }}>Originality: {session.proofStatus.originalityFingerprint}</div>
+          <div style={{ fontSize: 13 }}>Custody: {session.proofStatus.custodyLog}</div>
+          <div style={{ fontSize: 13 }}>Deletion protected: {session.proofStatus.deletionProtected ? "Yes" : "No"}</div>
+        </div>
+      </div>
+    </div>
+  );
+};
+
+const Stat: React.FC<{ label: string; value: string | number }> = ({ label, value }) => (
+  <div style={{ display: "flex", justifyContent: "space-between", marginBottom: 6 }}>
+    <div style={{ color: "#9aa4b2" }}>{label}</div>
+    <div style={{ fontWeight: 700 }}>{value}</div>
+  </div>
+);
+
+export default StudioSessionPanel;
+
