+export type IGoEventType =
+  | "IGO_MISSION_VIEWED"
+  | "IGO_INTENT_CREATED"
+  | "IGO_INTENT_STARTED"
+  | "IGO_USER_ARRIVED"
+  | "IGO_VERIFICATION_STARTED"
+  | "IGO_GPS_CHECK_RECORDED"
+  | "IGO_QR_SCAN_RECORDED"
+  | "IGO_NFC_TAP_RECORDED"
+  | "IGO_POPS_CHECK_RECORDED"
+  | "IGO_VERIFICATION_APPROVED"
+  | "IGO_VERIFICATION_REJECTED"
+  | "IGO_REWARD_APPROVED"
+  | "IGO_REWARD_PAID"
+  | "IGO_TRUST_UPDATED";
+
+export type IGoEvent = {
+  id: string;
+  type: IGoEventType;
+  missionId: string;
+  intentId?: string;
+  createdAtLabel: string;
+  metadata?: Record<string, string | number | boolean>;
+};
+
+export function createIGoEvent(input: {
+  type: IGoEventType;
+  missionId: string;
+  intentId?: string;
+  metadata?: Record<string, string | number | boolean>;
+}): IGoEvent {
+  return {
+    id: `igo-event-${Date.now()}-${Math.random().toString(16).slice(2)}`,
+    type: input.type,
+    missionId: input.missionId,
+    intentId: input.intentId,
+    createdAtLabel: "Just now",
+    metadata: input.metadata
+  };
+}
+
diff --git a/src/lib/igo/igo-proof.ts b/src/lib/igo/igo-proof.ts
new file mode 100644
index 0000000..db742bf
--- /dev/null
+++ b/src/lib/igo/igo-proof.ts
@@ -0,0 +1,126 @@
+import type {
+  IGoMission,
+  IGoIntent,
+  IGoProofOutcome,
+  IGoProofPackage,
+  IGoSettlementContract,
+  IGoReward,
+  IGoVerificationGate,
+  IGoPresenceCheck
+} from "./igo.types";
+
+function simpleHash(input: string): string {
+  // deterministic, small, safe local hash-like id (no crypto)
+  let h = 2166136261 >>> 0;
+  for (let i = 0; i < input.length; i++) {
+    h ^= input.charCodeAt(i);
+    h = Math.imul(h, 16777619) >>> 0;
+  }
+  // produce short base36 suffix
+  return (h >>> 0).toString(36).slice(-6);
+}
+
+export function createLocalIntegrityId(input: {
+  missionId: string;
+  intentId: string;
+  outcome: IGoProofOutcome;
+  verificationScore: number;
+  rewardStatus: string;
+}): string {
+  const raw = `${input.missionId}|${input.intentId}|${input.outcome}|${input.verificationScore}|${input.rewardStatus}`;
+  return `igo-proof-local-${simpleHash(raw)}`;
+}
+
+export function createIGoProofPackage(input: {
+  mission: IGoMission;
+  intent: IGoIntent;
+  outcome: IGoProofOutcome;
+  trustImpact: number;
+}): IGoProofPackage {
+  const { mission, intent, outcome, trustImpact } = input;
+  const verificationScore = intent.verificationScore ?? 0;
+  const rewardStatus = intent.rewardStatus ?? "none";
+
+  const localIntegrityId = createLocalIntegrityId({
+    missionId: mission.id,
+    intentId: intent.id,
+    outcome,
+    verificationScore,
+    rewardStatus
+  });
+
+  const gateSnapshot = (intent.gates ?? []).map((g) => ({ ...g }));
+  const checksSnapshot = (intent.checks ?? []).map((c) => ({ ...c }));
+
+  const proof: IGoProofPackage = {
+    id: `proof-${Date.now()}-${localIntegrityId}`,
+    missionId: mission.id,
+    intentId: intent.id,
+    outcome,
+    createdAtLabel: "Just now",
+    placeSnapshot: {
+      placeId: mission.place.id,
+      name: mission.place.name,
+      address: mission.place.address,
+      city: mission.place.city,
+      distanceLabel: mission.place.distanceLabel,
+      geofenceRadiusMeters: mission.place.geofenceRadiusMeters
+    },
+    rewardSnapshot: mission.reward,
+    gateSnapshot,
+    checksSnapshot,
+    verificationScore,
+    rewardStatus: rewardStatus as any,
+    trustImpact,
+    localIntegrityId,
+    notes: ["LOCAL MOCK PROOF: Not submitted to backend. For demo only."]
+  };
+
+  return proof;
+}
+
+export function createIGoSettlementContract(input: {
+  mission: IGoMission;
+  intent: IGoIntent;
+  proofPackage: IGoProofPackage;
+}): IGoSettlementContract {
+  const { mission, intent, proofPackage } = input;
+  const outcome = proofPackage.outcome;
+  const reward = mission.reward;
+  const icoin = reward.icoinAmount;
+  const creatorShare = mission.creatorHandle ? Math.round(icoin * 0.1) : undefined;
+  const platformFee = Math.round(icoin * 0.05);
+
+  let status: IGoSettlementContract["status"] = "not_ready";
+  if (outcome === "approved" && intent.rewardStatus === "approved") status = "ready";
+  else if (outcome === "rejected" || outcome === "expired") status = "blocked";
+  else if (outcome === "manual_review") status = "not_ready";
+
+  const contract: IGoSettlementContract = {
+    id: `settle-${Date.now()}-${proofPackage.localIntegrityId}`,
+    proofPackageId: proofPackage.id,
+    missionId: mission.id,
+    intentId: intent.id,
+    status,
+    userCredit: {
+      icoinAmount: reward.icoinAmount,
+      gcoinAmount: reward.gcoinAmount,
+      estimatedUsdLabel: reward.estimatedUsdLabel
+    },
+    creatorCredit: mission.creatorHandle
+      ? {
+          handle: mission.creatorHandle,
+          icoinAmount: creatorShare ?? 0
+        }
+      : undefined,
+    platformFee: {
+      icoinAmount: platformFee
+    },
+    walletLedgerMode: "mock_only",
+    settlementNote: "Local mock settlement contract. No ledger mutation performed.",
+    createdAtLabel: "Just now"
+  };
+
+  return contract;
+}
+
diff --git a/src/lib/igo/igo-state.ts b/src/lib/igo/igo-state.ts
new file mode 100644
index 0000000..0f80e3f
--- /dev/null
+++ b/src/lib/igo/igo-state.ts
@@ -0,0 +1,695 @@
+import { useMemo, useReducer } from "react";
+import type {
+  IGoCompletion,
+  IGoIntent,
+  IGoMission,
+  IGoEventLogItem,
+  IGoVerificationGate,
+  IGoRewardStatus,
+  IGoProofPackage,
+  IGoSettlementContract
+} from "./igo.types";
+import { IGO_DEFAULT_MISSION_ID, IGO_MOCK_MISSIONS } from "./igo.mock";
+import {
+  createInitialIntent,
+  createMockPresenceChecks,
+  getIGoProgressSteps
+  } from "./igo-verification";
+import {
+  createVerificationGates,
+  startAllVerificationGates,
+  passAllVerificationGates,
+  failFirstVerificationGate,
+  reviewVerificationGates,
+  createPresenceChecksFromGates,
+  calculateGateScore
+} from "./igo-verification";
+import { createIGoProofPackage, createIGoSettlementContract } from "./igo-proof";
+import {
+  createIGoAuditRecord,
+  createIGoCampaignOwnerSummary,
+  updateAuditRecordForSettlement,
+  updateAuditRecordRiskStatus
+} from "./igo-audit";
+import type { IGoAuditRecord, IGoCampaignOwnerSummary } from "./igo.types";
+import {
+  createInitialIGoCampaignDraft,
+  validateIGoCampaignDraft,
+  simulateIGoCampaignBudget,
+  createMockPublishedCampaign,
+  createMissionFromCampaignDraft,
+  hasBlockingCampaignErrors
+} from "./igo-campaign-builder";
+import type { IGoCampaignDraft, IGoCampaignRuleCheck, IGoCampaignBudgetSimulation, IGoMockPublishedCampaign, IGoCampaignDraftStatus } from "./igo.types";
+
+type IGoState = {
+  missions: IGoMission[];
+  selectedMissionId: string;
+  intent: IGoIntent | null;
+  completion: IGoCompletion | null;
+  eventLog: IGoEventLogItem[];
+  proofPackage?: IGoProofPackage | null;
+  settlementContract?: IGoSettlementContract | null;
+  ownerSummary?: IGoCampaignOwnerSummary | null;
+  auditRecords?: IGoAuditRecord[];
+  selectedAuditRecordId?: string | null;
+  campaignDraft?: IGoCampaignDraft | null;
+  campaignRuleChecks?: IGoCampaignRuleCheck[] | null;
+  campaignBudgetSimulation?: IGoCampaignBudgetSimulation | null;
+  mockPublishedCampaign?: IGoMockPublishedCampaign | null;
+};
+
+type IGoAction =
+  | { type: "select_mission"; missionId: string }
+  | { type: "select_audit_record"; recordId: string }
+  | { type: "clear_audit_selection" }
+  | { type: "queue_risk_review" }
+  | { type: "clear_risk_review" }
+  | { type: "block_risk_review" }
+  | { type: "create_intent" }
+  | { type: "start_mission" }
+  | { type: "mock_arrival" }
+  | { type: "start_verification" }
+  | { type: "pass_verification" }
+  | { type: "fail_verification" }
+  | { type: "send_manual_review" }
+  | { type: "approve_pending_reward" }
+  | { type: "reject_pending_reward" }
+  | { type: "tick_timer" }
+  | { type: "reset" }
+  | { type: "mark_mock_settled" }
+  | { type: "update_campaign_draft"; patch: Partial<IGoCampaignDraft> }
+  | { type: "validate_campaign_draft" }
+  | { type: "publish_mock_campaign" }
+  | { type: "reset_campaign_draft" };
+
+function makeInitialState(): IGoState {
+  return {
+    missions: IGO_MOCK_MISSIONS,
+    selectedMissionId: IGO_DEFAULT_MISSION_ID,
+    intent: null,
+    completion: null,
+    eventLog: []
+    ,proofPackage: null,
+    settlementContract: null
+    ,ownerSummary: null,
+    auditRecords: [],
+    selectedAuditRecordId: null
+    ,campaignDraft: createInitialIGoCampaignDraft(IGO_MOCK_MISSIONS[0]),
+    campaignRuleChecks: validateIGoCampaignDraft(createInitialIGoCampaignDraft(IGO_MOCK_MISSIONS[0])),
+    campaignBudgetSimulation: simulateIGoCampaignBudget(createInitialIGoCampaignDraft(IGO_MOCK_MISSIONS[0])),
+    mockPublishedCampaign: null
+  };
+}
+const initialState: IGoState = makeInitialState();
+
+function getSelectedMission(state: IGoState): IGoMission {
+  return (
+    state.missions.find((mission) => mission.id === state.selectedMissionId) ??
+    state.missions[0]
+  );
+}
+
+function reducer(state: IGoState, action: IGoAction): IGoState {
+  const selectedMission = getSelectedMission(state);
+
+  switch (action.type) {
+    case "select_mission":
+      {
+        const draftFromMission = createInitialIGoCampaignDraft(state.missions.find((m) => m.id === action.missionId) ?? state.missions[0]);
+        return {
+          ...state,
+          selectedMissionId: action.missionId,
+          intent: null,
+          completion: null,
+          campaignDraft: draftFromMission,
+          campaignRuleChecks: validateIGoCampaignDraft(draftFromMission),
+          campaignBudgetSimulation: simulateIGoCampaignBudget(draftFromMission),
+          mockPublishedCampaign: null
+        };
+      }
+
+    case "create_intent":
+      return {
+        ...state,
+        intent: {
+          ...createInitialIntent(selectedMission),
+          rewardStatus: "none",
+          gates: [], // will be created on start or immediately
+          remainingSeconds: selectedMission.timeLimitMinutes * 60,
+          verificationScore: 0
+        },
+        completion: null,
+        eventLog: [
+          {
+            id: `evt-${Date.now()}`,
+            type: "intent_created",
+            label: "Intent created",
+            detail: selectedMission.title,
+            createdAtLabel: "Just now"
+          },
+          ...state.eventLog
+        ]
+      };
+
+    case "start_mission":
+      if (!state.intent) return state;
+
+      return {
+        ...state,
+        intent: {
+          ...state.intent,
+          status: "active",
+          startedAtLabel: "Just now",
+          progressPercent: 40
+        }
+      };
+
+    case "mock_arrival":
+      if (!state.intent) return state;
+
+      return {
+        ...state,
+        intent: {
+          ...state.intent,
+          status: "arrived",
+          arrivedAtLabel: "Just now",
+          progressPercent: 60,
+          dwellSeconds: selectedMission.minDwellSeconds
+        }
+      };
+
+    case "start_verification":
+      if (!state.intent) return state;
+      // create gates from mission requirements
+      {
+        const gates: IGoVerificationGate[] = createVerificationGates(selectedMission);
+        const checking = startAllVerificationGates(gates);
+        const checks = createPresenceChecksFromGates(checking);
+        const score = calculateGateScore(checking);
+        return {
+          ...state,
+          intent: {
+            ...state.intent,
+            status: "verifying",
+            progressPercent: 80,
+            gates: checking,
+            checks,
+            verificationScore: score,
+            rewardStatus: "none"
+          },
+          eventLog: [
+            {
+              id: `evt-${Date.now()}`,
+              type: "verification_started",
+              label: "Verification started",
+              detail: selectedMission.title,
+              createdAtLabel: "Just now"
+            },
+            ...state.eventLog
+          ]
+        };
+      }
+
+    case "update_campaign_draft":
+      {
+        const patch = (action as any).patch as Partial<IGoCampaignDraft>;
+        const newDraft = { ...(state.campaignDraft ?? createInitialIGoCampaignDraft(selectedMission)), ...patch };
+        const checks = validateIGoCampaignDraft(newDraft);
+        const sim = simulateIGoCampaignBudget(newDraft);
+        const status: IGoCampaignDraftStatus = hasBlockingCampaignErrors(checks) ? "invalid" : "valid";
+        return {
+          ...state,
+          campaignDraft: { ...newDraft, status },
+          campaignRuleChecks: checks,
+          campaignBudgetSimulation: sim,
+          eventLog: [{ id: `evt-${Date.now()}`, type: "campaign_draft_updated", label: "Campaign draft updated", detail: newDraft.title, createdAtLabel: "Just now" }, ...state.eventLog]
+        };
+      }
+
+    case "validate_campaign_draft":
+      {
+        const draft = state.campaignDraft ?? createInitialIGoCampaignDraft(selectedMission);
+        const checks = validateIGoCampaignDraft(draft);
+        const sim = simulateIGoCampaignBudget(draft);
+        return {
+          ...state,
+          campaignRuleChecks: checks,
+          campaignBudgetSimulation: sim,
+          eventLog: [{ id: `evt-${Date.now()}`, type: "campaign_rules_checked", label: "Campaign rules checked", detail: draft.title, createdAtLabel: "Just now" }, ...state.eventLog]
+        };
+      }
+
+    case "publish_mock_campaign":
+      {
+        const draft = state.campaignDraft ?? createInitialIGoCampaignDraft(selectedMission);
+        const checks = validateIGoCampaignDraft(draft);
+        if (hasBlockingCampaignErrors(checks)) {
+          return {
+            ...state,
+            campaignRuleChecks: checks,
+            eventLog: [{ id: `evt-${Date.now()}`, type: "campaign_mock_publish_failed", label: "Mock publish failed", detail: draft.title, createdAtLabel: "Just now" }, ...state.eventLog]
+          };
+        }
+        const sim = simulateIGoCampaignBudget(draft);
+        const published = createMockPublishedCampaign({ draft, ruleChecks: checks, budgetSimulation: sim });
+        const mission = createMissionFromCampaignDraft(draft);
+        const missions = [mission, ...state.missions];
+        return {
+          ...state,
+          missions,
+          selectedMissionId: mission.id,
+          campaignDraft: { ...draft, status: "mock_published", isMockPublished: true },
+          campaignRuleChecks: checks,
+          campaignBudgetSimulation: sim,
+          mockPublishedCampaign: published,
+          // clear user intent/completion/proof/audit to keep separation
+          intent: null,
+          completion: null,
+          proofPackage: null,
+          settlementContract: null,
+          auditRecords: [],
+          ownerSummary: null,
+          eventLog: [{ id: `evt-${Date.now()}`, type: "campaign_mock_published", label: "Campaign mock published", detail: draft.title, createdAtLabel: "Just now" }, ...state.eventLog]
+        };
+      }
+
+    case "reset_campaign_draft":
+      {
+        const draft = createInitialIGoCampaignDraft(selectedMission);
+        return {
+          ...state,
+          campaignDraft: draft,
+          campaignRuleChecks: validateIGoCampaignDraft(draft),
+          campaignBudgetSimulation: simulateIGoCampaignBudget(draft),
+          mockPublishedCampaign: null,
+          eventLog: [{ id: `evt-${Date.now()}`, type: "campaign_draft_updated", label: "Campaign draft reset", detail: draft.title, createdAtLabel: "Just now" }, ...state.eventLog]
+        };
+      }
+
+    case "pass_verification":
+      if (!state.intent) return state;
+      // pass all gates
+      {
+        const passedGates = passAllVerificationGates(state.intent.gates ?? []);
+        const checks = createPresenceChecksFromGates(passedGates);
+        const score = calculateGateScore(passedGates);
+        return {
+          ...state,
+          intent: {
+            ...state.intent,
+            status: "verifying",
+            gates: passedGates,
+            checks,
+            verificationScore: score,
+            rewardStatus: "pending"
+          },
+          eventLog: [
+            {
+              id: `evt-${Date.now()}`,
+              type: "gate_passed",
+              label: "Verification passed",
+              detail: selectedMission.title,
+              createdAtLabel: "Just now"
+            },
+            {
+              id: `evt2-${Date.now()}`,
+              type: "reward_pending",
+              label: "Reward pending",
+              detail: "Awaiting approval",
+              createdAtLabel: "Just now"
+            },
+            ...state.eventLog
+          ]
+        };
+      }
+
+    case "fail_verification":
+      if (!state.intent) return state;
+      {
+        const failedGates = failFirstVerificationGate(state.intent.gates ?? []);
+        const checks = createPresenceChecksFromGates(failedGates);
+        const score = calculateGateScore(failedGates);
+        const proof = createIGoProofPackage({ mission: selectedMission, intent: state.intent, outcome: "rejected", trustImpact: 0 });
+        const settle = createIGoSettlementContract({ mission: selectedMission, intent: state.intent, proofPackage: proof });
+        return {
+          ...state,
+          intent: {
+            ...state.intent,
+            status: "rejected",
+            gates: failedGates,
+            checks,
+            verificationScore: score,
+            rewardStatus: "rejected"
+          },
+          completion: null,
+          proofPackage: proof,
+          settlementContract: settle,
+          eventLog: [
+            {
+              id: `evt-${Date.now()}`,
+              type: "proof_package_created",
+              label: "Proof package created",
+              detail: selectedMission.title,
+              createdAtLabel: "Just now"
+            },
+            {
+              id: `evt2-${Date.now()}`,
+              type: "gate_failed",
+              label: "Verification failed",
+              detail: selectedMission.title,
+              createdAtLabel: "Just now"
+            },
+            {
+              id: `evt3-${Date.now()}`,
+              type: "reward_rejected",
+              label: "Reward rejected",
+              detail: "Verification failed",
+              createdAtLabel: "Just now"
+            },
+            ...state.eventLog
+          ]
+        };
+      }
+
+    case "send_manual_review":
+      if (!state.intent) return state;
+      {
+        const reviewGates = reviewVerificationGates(state.intent.gates ?? []);
+        const checks = createPresenceChecksFromGates(reviewGates);
+        const score = calculateGateScore(reviewGates);
+        const proof = createIGoProofPackage({ mission: selectedMission, intent: state.intent, outcome: "manual_review", trustImpact: 0 });
+        const settle = createIGoSettlementContract({ mission: selectedMission, intent: state.intent, proofPackage: proof });
+        const auditRec = createIGoAuditRecord({ mission: selectedMission, intent: state.intent, proofPackage: proof, settlementContract: settle });
+        const newRecords = [auditRec, ...(state.auditRecords ?? [])];
+        return {
+          ...state,
+          intent: {
+            ...state.intent,
+            status: "verifying",
+            gates: reviewGates,
+            checks,
+            verificationScore: score,
+            rewardStatus: "manual_review"
+          },
+          proofPackage: proof,
+          settlementContract: settle,
+          auditRecords: newRecords,
+          ownerSummary: createIGoCampaignOwnerSummary({ mission: selectedMission, records: newRecords }),
+          eventLog: [
+            {
+              id: `evt-${Date.now()}`,
+              type: "proof_package_created",
+              label: "Proof package created (manual review)",
+              detail: selectedMission.title,
+              createdAtLabel: "Just now"
+            },
+            {
+              id: `evt2-${Date.now()}`,
+              type: "manual_review",
+              label: "Sent for manual review",
+              detail: selectedMission.title,
+              createdAtLabel: "Just now"
+            },
+            ...state.eventLog
+          ]
+        };
+      }
+
+    case "approve_pending_reward":
+      if (!state.intent) return state;
+      {
+        const completion = {
+          intentId: state.intent.id,
+          missionId: selectedMission.id,
+          approved: true,
+          reward: selectedMission.reward,
+          proofId: `igo-proof-${selectedMission.id}`,
+          trustImpact: 0.3,
+          completedAtLabel: "Just now"
+        } as IGoCompletion;
+
+        const proof = createIGoProofPackage({
+          mission: selectedMission,
+          intent: state.intent,
+          outcome: "approved",
+          trustImpact: completion.trustImpact
+        });
+        const settle = createIGoSettlementContract({ mission: selectedMission, intent: state.intent, proofPackage: proof });
+
+        const auditRec = createIGoAuditRecord({ mission: selectedMission, intent: state.intent, proofPackage: proof, settlementContract: settle });
+        const newRecords = [auditRec, ...(state.auditRecords ?? [])];
+        return {
+          ...state,
+          intent: {
+            ...state.intent,
+            status: "completed",
+            rewardStatus: "approved",
+            completedAtLabel: "Just now",
+            progressPercent: 100
+          },
+          completion,
+          proofPackage: proof,
+          settlementContract: settle,
+          auditRecords: newRecords,
+          ownerSummary: createIGoCampaignOwnerSummary({ mission: selectedMission, records: newRecords }),
+          eventLog: [
+            {
+              id: `evt-${Date.now()}`,
+              type: "proof_package_created",
+              label: "Proof package created",
+              detail: selectedMission.title,
+              createdAtLabel: "Just now"
+            },
+            {
+              id: `evt2-${Date.now()}`,
+              type: settle.status === "ready" ? "settlement_ready" : "proof_package_created",
+              label: settle.status === "ready" ? "Settlement ready (mock)" : "Settlement pending",
+              detail: settle.settlementNote,
+              createdAtLabel: "Just now"
+            },
+            {
+              id: `evt3-${Date.now()}`,
+              type: "reward_approved",
+              label: "Reward approved",
+              detail: selectedMission.title,
+              createdAtLabel: "Just now"
+            },
+            ...state.eventLog
+          ]
+        };
+      }
+
+    case "reject_pending_reward":
+      if (!state.intent) return state;
+      {
+        const proof = createIGoProofPackage({
+          mission: selectedMission,
+          intent: state.intent,
+          outcome: "rejected",
+          trustImpact: 0
+        });
+        const settle = createIGoSettlementContract({ mission: selectedMission, intent: state.intent, proofPackage: proof });
+        const auditRec = createIGoAuditRecord({ mission: selectedMission, intent: state.intent, proofPackage: proof, settlementContract: settle });
+        const newRecords = [auditRec, ...(state.auditRecords ?? [])];
+        return {
+          ...state,
+          intent: {
+            ...state.intent,
+            status: "rejected",
+            rewardStatus: "rejected"
+          },
+          completion: null,
+          proofPackage: proof,
+          settlementContract: settle,
+          auditRecords: newRecords,
+          ownerSummary: createIGoCampaignOwnerSummary({ mission: selectedMission, records: newRecords }),
+          eventLog: [
+            {
+              id: `evt-${Date.now()}`,
+              type: "proof_package_created",
+              label: "Proof package created",
+              detail: selectedMission.title,
+              createdAtLabel: "Just now"
+            },
+            {
+              id: `evt2-${Date.now()}`,
+              type: "reward_rejected",
+              label: "Reward rejected",
+              detail: selectedMission.title,
+              createdAtLabel: "Just now"
+            },
+            ...state.eventLog
+          ]
+        };
+      }
+
+    case "tick_timer":
+      if (!state.intent) return state;
+      if (state.intent.remainingSeconds && state.intent.remainingSeconds > 0) {
+        const rem = state.intent.remainingSeconds - 1;
+        if (rem <= 0) {
+          // expire: create proof + blocked settlement
+          const proof = createIGoProofPackage({ mission: selectedMission, intent: state.intent!, outcome: "expired", trustImpact: 0 });
+          const settle = createIGoSettlementContract({ mission: selectedMission, intent: state.intent!, proofPackage: proof });
+          const auditRec = createIGoAuditRecord({ mission: selectedMission, intent: state.intent!, proofPackage: proof, settlementContract: settle });
+          const newRecords = [auditRec, ...(state.auditRecords ?? [])];
+          return {
+            ...state,
+            intent: {
+              ...state.intent,
+              remainingSeconds: 0,
+              status: "expired",
+              rewardStatus: "rejected"
+            },
+            proofPackage: proof,
+            settlementContract: settle,
+            auditRecords: newRecords,
+            ownerSummary: createIGoCampaignOwnerSummary({ mission: selectedMission, records: newRecords }),
+            eventLog: [
+              {
+                id: `evt-${Date.now()}`,
+                type: "proof_package_created",
+                label: "Proof package created (expired)",
+                detail: selectedMission.title,
+                createdAtLabel: "Just now"
+              },
+              {
+                id: `evt2-${Date.now()}`,
+                type: "expired",
+                label: "Mission expired",
+                detail: selectedMission.title,
+                createdAtLabel: "Just now"
+              },
+              ...state.eventLog
+            ]
+          };
+        }
+        return {
+          ...state,
+          intent: {
+            ...state.intent,
+            remainingSeconds: rem
+          }
+        };
+      }
+
+    case "reset":
+      return makeInitialState();
+    case "mark_mock_settled":
+      if (!state.settlementContract) return state;
+      if (state.settlementContract.status !== "ready") return state;
+      {
+        const updatedSettlement = { ...state.settlementContract, status: "mock_settled" as const };
+        // update matching audit record
+        const records = (state.auditRecords ?? []).map((r) =>
+          r.settlementContractId === state.settlementContract!.id || r.proofPackageId === state.proofPackage?.id
+            ? updateAuditRecordForSettlement(r)
+            : r
+        );
+        return {
+          ...state,
+          settlementContract: updatedSettlement,
+          auditRecords: records,
+          ownerSummary: createIGoCampaignOwnerSummary({ mission: selectedMission, records }),
+          eventLog: [
+            {
+              id: `evt-${Date.now()}`,
+              type: "mock_settled",
+              label: "Mock settled",
+              detail: state.settlementContract.settlementNote,
+              createdAtLabel: "Just now"
+            },
+            ...state.eventLog
+          ]
+        };
+      }
+    case "select_audit_record":
+      return { ...state, selectedAuditRecordId: (action as any).recordId ?? null };
+    case "clear_audit_selection":
+      return { ...state, selectedAuditRecordId: null };
+    case "queue_risk_review":
+      {
+        const sel = state.selectedAuditRecordId;
+        if (!sel) return state;
+        const records = (state.auditRecords ?? []).map((r) => (r.id === sel ? updateAuditRecordRiskStatus(r, "queued") : r));
+        return {
+          ...state,
+          auditRecords: records,
+          ownerSummary: createIGoCampaignOwnerSummary({ mission: selectedMission, records }),
+          eventLog: [{ id: `evt-${Date.now()}`, type: "risk_review_queued", label: "Risk review queued", detail: sel, createdAtLabel: "Just now" }, ...state.eventLog]
+        };
+      }
+    case "clear_risk_review":
+      {
+        const sel = state.selectedAuditRecordId;
+        if (!sel) return state;
+        const records = (state.auditRecords ?? []).map((r) => (r.id === sel ? updateAuditRecordRiskStatus(r, "cleared") : r));
+        return {
+          ...state,
+          auditRecords: records,
+          ownerSummary: createIGoCampaignOwnerSummary({ mission: selectedMission, records }),
+          eventLog: [{ id: `evt-${Date.now()}`, type: "risk_review_cleared", label: "Risk review cleared", detail: sel, createdAtLabel: "Just now" }, ...state.eventLog]
+        };
+      }
+    case "block_risk_review":
+      {
+        const sel = state.selectedAuditRecordId;
+        if (!sel) return state;
+        const records = (state.auditRecords ?? []).map((r) => (r.id === sel ? updateAuditRecordRiskStatus(r, "blocked") : r));
+        return {
+          ...state,
+          auditRecords: records,
+          ownerSummary: createIGoCampaignOwnerSummary({ mission: selectedMission, records }),
+          eventLog: [{ id: `evt-${Date.now()}`, type: "risk_review_blocked", label: "Risk review blocked", detail: sel, createdAtLabel: "Just now" }, ...state.eventLog]
+        };
+      }
+  }
+}
+
+// Export the reducer and a factory for the initial state for focused unit testing.
+// These exports are intentionally minimal and do not change runtime behavior
+// of the `useIGoState` hook which continues to use the same `reducer` and
+// `initialState` internally.
+export const igoReducer = reducer;
+export function createInitialIGoState(): IGoState {
+  return makeInitialState();
+}
+
+export function useIGoState() {
+  const [state, dispatch] = useReducer(reducer, initialState);
+
+  const selectedMission = useMemo(() => getSelectedMission(state), [state]);
+
+  const progressSteps = useMemo(() => getIGoProgressSteps(state.intent), [state.intent]);
+
+  return {
+    state,
+    selectedMission,
+    progressSteps,
+    selectMission: (missionId: string) => dispatch({ type: "select_mission", missionId }),
+    selectAuditRecord: (recordId: string) => dispatch({ type: "select_audit_record", recordId }),
+    clearAuditSelection: () => dispatch({ type: "clear_audit_selection" }),
+    queueRiskReview: () => dispatch({ type: "queue_risk_review" }),
+    clearRiskReview: () => dispatch({ type: "clear_risk_review" }),
+    blockRiskReview: () => dispatch({ type: "block_risk_review" }),
+    
+    createIntent: () => dispatch({ type: "create_intent" }),
+    startMission: () => dispatch({ type: "start_mission" }),
+    mockArrival: () => dispatch({ type: "mock_arrival" }),
+    startVerification: () => dispatch({ type: "start_verification" }),
+    passVerification: () => dispatch({ type: "pass_verification" }),
+    failVerification: () => dispatch({ type: "fail_verification" }),
+    sendManualReview: () => dispatch({ type: "send_manual_review" }),
+    approvePendingReward: () => dispatch({ type: "approve_pending_reward" }),
+    rejectPendingReward: () => dispatch({ type: "reject_pending_reward" }),
+    tickTimer: () => dispatch({ type: "tick_timer" }),
+    markMockSettled: () => dispatch({ type: "mark_mock_settled" }),
+    updateCampaignDraft: (patch: Partial<IGoCampaignDraft>) => dispatch({ type: "update_campaign_draft", patch }),
+    validateCampaignDraft: () => dispatch({ type: "validate_campaign_draft" }),
+    publishMockCampaign: () => dispatch({ type: "publish_mock_campaign" }),
+    resetCampaignDraft: () => dispatch({ type: "reset_campaign_draft" }),
+    reset: () => dispatch({ type: "reset" })
+  };
+}
+
