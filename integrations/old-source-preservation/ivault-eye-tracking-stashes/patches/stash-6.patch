+import React from "react";
+import type { IGoProgressStep } from "../../lib/igo/igo.types";
+
+type IGoProgressStepsProps = {
+  steps: IGoProgressStep[];
+};
+
+export const IGoProgressSteps: React.FC<IGoProgressStepsProps> = ({ steps }) => {
+  return (
+    <div className="space-y-2">
+      {steps.map((s) => {
+        const bg =
+          s.state === "done"
+            ? "bg-green-700"
+            : s.state === "current"
+            ? "bg-blue-600"
+            : s.state === "failed"
+            ? "bg-red-700"
+            : "bg-gray-800";
