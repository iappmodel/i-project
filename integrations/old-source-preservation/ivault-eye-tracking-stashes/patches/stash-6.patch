+export type IGoMissionStatus =
+  | "available"
+  | "reserved"
+  | "active"
+  | "arrived"
+  | "verifying"
+  | "completed"
+  | "expired"
+  | "cancelled"
+  | "rejected";
+
+export type IGoVerificationMethod =
+  | "gps"
+  | "qr_scan"
+  | "nfc_tap"
+  | "merchant_confirm"
+  | "receipt"
+  | "payment"
+  | "device_motion"
+  | "pops_liveness"
+  | "camera_context";
+
+export type IGoVerificationResult =
+  | "pending"
+  | "pass"
+  | "fail"
+  | "uncertain"
+  | "manual_review";
+
+export type IGoCampaignType =
+  | "visit"
+  | "event_attendance"
+  | "purchase"
+  | "creator_referral"
+  | "challenge"
+  | "local_discovery";
+
+export type IGoRiskLevel = "low" | "medium" | "high";
+
+export type IGoPlace = {
+  id: string;
+  name: string;
+  placeType: string;
+  address: string;
+  city: string;
+  distanceLabel: string;
+  distanceMeters: number;
+  geofenceRadiusMeters: number;
+  isOpenNow: boolean;
+  openUntilLabel: string;
+  trustTier: "standard" | "verified" | "premium";
+};
+
+export type IGoReward = {
+  icoinAmount: number;
+  gcoinAmount: number;
+  estimatedUsdLabel: string;
+  creatorSplitAmount?: number;
+  platformFeeAmount?: number;
+};
+
+export type IGoRequirement = {
+  id: string;
+  label: string;
+  detail: string;
+  method: IGoVerificationMethod;
+  required: boolean;
+};
+
+export type IGoMission = {
+  id: string;
+  campaignType: IGoCampaignType;
+  title: string;
+  description: string;
+  sponsorName: string;
+  creatorHandle?: string;
+  place: IGoPlace;
+  reward: IGoReward;
+  requirements: IGoRequirement[];
+  minDwellSeconds: number;
+  timeLimitMinutes: number;
+  startsAtLabel: string;
+  endsAtLabel: string;
+  riskLevel: IGoRiskLevel;
+  requiredVerificationLevel: 1 | 2 | 3 | 4 | 5;
+  status: IGoMissionStatus;
+};
+
+export type IGoPresenceCheck = {
+  id: string;
+  method: IGoVerificationMethod;
+  label: string;
+  result: IGoVerificationResult;
+  checkedAtLabel?: string;
+  riskScore?: number;
+};
+
+export type IGoIntent = {
+  id: string;
+  missionId: string;
+  status: IGoMissionStatus;
+  declaredAtLabel: string;
+  startedAtLabel?: string;
+  arrivedAtLabel?: string;
+  completedAtLabel?: string;
+  progressPercent: number;
+  dwellSeconds: number;
+  checks: IGoPresenceCheck[];
+  // Stage 2 additions:
+  rewardStatus?: IGoRewardStatus;
+  gates?: IGoVerificationGate[];
+  remainingSeconds?: number;
+  verificationScore?: number;
+};
+
+export type IGoCompletion = {
+  intentId: string;
+  missionId: string;
+  approved: boolean;
+  reward: IGoReward;
+  proofId: string;
+  trustImpact: number;
+  completedAtLabel: string;
+};
+
+export type IGoStepId =
+  | "intent"
+  | "travel"
+  | "arrival"
+  | "verification"
+  | "reward";
+
+export type IGoProgressStep = {
+  id: IGoStepId;
+  label: string;
+  state: "locked" | "current" | "done" | "failed";
+};
+
+// Stage 2 types
+export type IGoRewardStatus =
+  | "none"
+  | "pending"
+  | "approved"
+  | "rejected"
+  | "paid"
+  | "manual_review";
+
+export type IGoVerificationGateStatus =
+  | "locked"
+  | "ready"
+  | "checking"
+  | "passed"
+  | "failed"
+  | "review";
+
+export type IGoVerificationGate = {
+  id: string;
+  method: IGoVerificationMethod;
+  label: string;
+  detail: string;
+  required: boolean;
+  status: IGoVerificationGateStatus;
+  checkedAtLabel?: string;
+  riskScore?: number;
+};
+
+export type IGoEventLogItem = {
+  id: string;
+  type:
+    | "mission_selected"
+    | "intent_created"
+    | "mission_started"
+    | "arrival_mocked"
+    | "verification_started"
+    | "gate_passed"
+    | "gate_failed"
+    | "reward_pending"
+    | "reward_approved"
+    | "reward_rejected"
+    | "manual_review"
+    | "proof_package_created"
+    | "settlement_ready"
+    | "mock_settled"
+    | "risk_review_queued"
+    | "risk_review_cleared"
+    | "risk_review_blocked"
+  | "campaign_draft_updated"
+  | "campaign_rules_checked"
+  | "campaign_mock_published"
+  | "campaign_mock_publish_failed"
+    | "mission_reset"
+    | "expired";
+  label: string;
+  detail?: string;
+  createdAtLabel: string;
+};
+
+// Stage 3: proof and settlement types
+export type IGoProofOutcome =
+  | "approved"
+  | "rejected"
+  | "manual_review"
+  | "expired";
+
+export type IGoProofPackage = {
+  id: string;
+  missionId: string;
+  intentId: string;
+  outcome: IGoProofOutcome;
+  createdAtLabel: string;
+  placeSnapshot: {
+    placeId: string;
+    name: string;
+    address: string;
+    city: string;
+    distanceLabel: string;
+    geofenceRadiusMeters: number;
+  };
+  rewardSnapshot: IGoReward;
+  gateSnapshot: IGoVerificationGate[];
+  checksSnapshot: IGoPresenceCheck[];
+  verificationScore: number;
+  rewardStatus: IGoRewardStatus;
+  trustImpact: number;
+  localIntegrityId: string;
+  notes: string[];
+};
+
+export type IGoSettlementStatus =
+  | "not_ready"
+  | "ready"
+  | "blocked"
+  | "mock_settled";
+
+export type IGoSettlementContract = {
+  id: string;
+  proofPackageId: string;
+  missionId: string;
+  intentId: string;
+  status: IGoSettlementStatus;
+  userCredit: {
+    icoinAmount: number;
+    gcoinAmount: number;
+    estimatedUsdLabel: string;
+  };
+  creatorCredit?: {
+    handle: string;
+    icoinAmount: number;
+  };
+  platformFee?: {
+    icoinAmount: number;
+  };
+  walletLedgerMode: "mock_only";
+  settlementNote: string;
+  createdAtLabel: string;
+};
+
+// Stage 4: owner/audit types
+export type IGoAuditStatus =
+  | "clean"
+  | "needs_review"
+  | "rejected"
+  | "settlement_ready"
+  | "mock_settled";
+
+export type IGoRiskReviewStatus =
+  | "not_required"
+  | "queued"
+  | "reviewing"
+  | "cleared"
+  | "blocked";
+
+export type IGoCampaignOwnerSummary = {
+  campaignId: string;
+  missionId: string;
+  sponsorName: string;
+  placeName: string;
+  campaignType: IGoCampaignType;
+  totalBudgetLabel: string;
+  spentLabel: string;
+  pendingLabel: string;
+  remainingLabel: string;
+  completions: number;
+  approvals: number;
+  rejections: number;
+  manualReviews: number;
+  mockSettlements: number;
+  averageVerificationScore: number;
+};
+
+export type IGoAuditRecord = {
+  id: string;
+  missionId: string;
+  intentId: string;
+  proofPackageId?: string;
+  settlementContractId?: string;
+  userLabel: string;
+  placeName: string;
+  outcome: IGoProofOutcome;
+  rewardStatus: IGoRewardStatus;
+  settlementStatus: IGoSettlementStatus;
+  auditStatus: IGoAuditStatus;
+  riskReviewStatus: IGoRiskReviewStatus;
+  verificationScore: number;
+  localIntegrityId?: string;
+  createdAtLabel: string;
+};
+
+// Stage 5: campaign builder types
+export type IGoCampaignDraftStatus =
+  | "draft"
+  | "valid"
+  | "invalid"
+  | "mock_published";
+
+export type IGoCampaignBudgetMode =
+  | "fixed_total"
+  | "per_completion_cap"
+  | "unlimited_mock";
+
+export type IGoCampaignRuleSeverity = "info" | "warning" | "error";
+
+export type IGoCampaignDraft = {
+  id: string;
+  status: IGoCampaignDraftStatus;
+  title: string;
+  description: string;
+  sponsorName: string;
+  creatorHandle?: string;
+  campaignType: IGoCampaignType;
+  place: IGoPlace;
+  reward: IGoReward;
+  minDwellSeconds: number;
+  timeLimitMinutes: number;
+  requiredVerificationLevel: 1 | 2 | 3 | 4 | 5;
+  maxCompletions: number;
+  maxCompletionsPerUser: number;
+  budgetMode: IGoCampaignBudgetMode;
+  totalBudgetAmount: number;
+  startsAtLabel: string;
+  endsAtLabel: string;
+  isMockPublished: boolean;
+};
+
+export type IGoCampaignRuleCheck = {
+  id: string;
+  label: string;
+  detail: string;
+  severity: IGoCampaignRuleSeverity;
+  passed: boolean;
+};
+
+export type IGoCampaignBudgetSimulation = {
+  totalBudgetLabel: string;
+  rewardPerCompletionLabel: string;
+  maxAffordableCompletions: number;
+  configuredMaxCompletions: number;
+  estimatedSpendLabel: string;
+  estimatedRemainingLabel: string;
+  budgetRisk: "low" | "medium" | "high";
+};
+
+export type IGoMockPublishedCampaign = {
+  id: string;
+  draftId: string;
+  mission: IGoMission;
+  publishedAtLabel: string;
+  ruleChecks: IGoCampaignRuleCheck[];
+  budgetSimulation: IGoCampaignBudgetSimulation;
+};
diff --git a/src/lib/igo/tests/igo.reducer.test.ts b/src/lib/igo/tests/igo.reducer.test.ts
new file mode 100644
index 0000000..589c6cc
--- /dev/null
+++ b/src/lib/igo/tests/igo.reducer.test.ts
@@ -0,0 +1,267 @@
+import assert from "assert";
+import { igoReducer, createInitialIGoState } from "../igo-state";
+import { IGO_DEFAULT_MISSION_ID, IGO_MOCK_MISSIONS } from "../igo.mock";
+import type {
+  IGoMission,
+  IGoVerificationGate,
+  IGoCampaignRuleCheck,
+} from "../igo.types";
+
+// TypeScript-only reducer verification module (no test runner required).
+// A test runner (vitest/jest) can import and call runIGoReducerChecks(),
+// or a maintainer can call it directly.
+export function runIGoReducerChecks(): void {
+  let state = createInitialIGoState();
+
+  // ── Stage 1 ──────────────────────────────────────────────────────────────
+
+  // initial selected mission is the default
+  assert.strictEqual(
+    state.selectedMissionId,
+    IGO_DEFAULT_MISSION_ID,
+    "initial selectedMissionId should be the default"
+  );
+
+  // event log empty initially
+  assert.ok(
+    Array.isArray(state.eventLog) && state.eventLog.length === 0,
+    "eventLog should start empty"
+  );
+
+  // create_intent → reserved intent
+  state = igoReducer(state, { type: "create_intent" } as Parameters<typeof igoReducer>[1]);
+  assert.ok(state.intent, "intent should exist after create_intent");
+  assert.strictEqual(state.intent!.status, "reserved", "intent should be reserved");
+  assert.strictEqual(state.completion, null, "completion should be null after create_intent");
+  assert.ok(Array.isArray(state.intent!.gates), "gates array should exist on intent");
+  assert.strictEqual(typeof state.intent!.remainingSeconds, "number", "remainingSeconds should be set");
+
+  // start_mission → active
+  state = igoReducer(state, { type: "start_mission" } as Parameters<typeof igoReducer>[1]);
+  assert.strictEqual(state.intent!.status, "active", "intent should be active after start_mission");
+
+  // mock_arrival → arrived + dwellSeconds
+  const selectedMissionBefore = state.missions.find(
+    (m: IGoMission) => m.id === state.selectedMissionId
+  )!;
+  state = igoReducer(state, { type: "mock_arrival" } as Parameters<typeof igoReducer>[1]);
+  assert.strictEqual(state.intent!.status, "arrived", "intent should be arrived after mock_arrival");
+  assert.strictEqual(
+    state.intent!.dwellSeconds,
+    selectedMissionBefore.minDwellSeconds,
+    "dwellSeconds should equal mission.minDwellSeconds"
+  );
+
+  // start_verification → verifying + gates present
+  state = igoReducer(state, { type: "start_verification" } as Parameters<typeof igoReducer>[1]);
+  assert.strictEqual(state.intent!.status, "verifying", "intent should be verifying");
+  assert.ok(
+    Array.isArray(state.intent!.gates) && state.intent!.gates.length > 0,
+    "gates should be present"
+  );
+  assert.ok(
+    state.intent!.gates!.some((g: IGoVerificationGate) => g.status === "checking"),
+    "at least some gates should be checking"
+  );
+
+  // pass_verification → pending reward, all required gates passed
+  state = igoReducer(state, { type: "pass_verification" } as Parameters<typeof igoReducer>[1]);
+  assert.strictEqual(
+    state.intent!.rewardStatus,
+    "pending",
+    "rewardStatus should be pending after pass_verification"
+  );
+  assert.ok(
+    state.intent!.gates!.every(
+      (g: IGoVerificationGate) => g.status === "passed" || !g.required
+    ),
+    "required gates should be passed"
+  );
+
+  // approve_pending_reward → completed + completion + proof + settlement
+  state = igoReducer(state, { type: "approve_pending_reward" } as Parameters<typeof igoReducer>[1]);
+  assert.strictEqual(state.intent!.status, "completed", "intent should be completed");
+  assert.ok(state.completion, "completion should be present");
+  assert.strictEqual(state.completion!.approved, true, "completion.approved should be true");
+  assert.ok(state.proofPackage, "proofPackage should be present after approve_pending_reward");
+  assert.ok(state.settlementContract, "settlementContract should be present");
+  if (state.settlementContract) {
+    assert.ok(
+      ["ready", "not_ready", "blocked"].includes(state.settlementContract.status),
+      "settlement status should be a known value"
+    );
+  }
+
+  // mark_mock_settled
+  const prevStatus = state.settlementContract?.status;
+  state = igoReducer(state, { type: "mark_mock_settled" } as Parameters<typeof igoReducer>[1]);
+  if (prevStatus === "ready") {
+    assert.strictEqual(
+      state.settlementContract!.status,
+      "mock_settled",
+      "settlement should be mock_settled when previously ready"
+    );
+  } else {
+    assert.strictEqual(
+      state.settlementContract!.status,
+      prevStatus,
+      "settlement status unchanged if not ready"
+    );
+  }
+
+  // select_mission → resets intent and completion
+  const otherMission =
+    IGO_MOCK_MISSIONS.find((m: IGoMission) => m.id !== state.selectedMissionId) ??
+    IGO_MOCK_MISSIONS[0];
+  state = igoReducer(state, {
+    type: "select_mission",
+    missionId: otherMission.id,
+  } as Parameters<typeof igoReducer>[1]);
+  assert.strictEqual(state.selectedMissionId, otherMission.id, "selectedMissionId should update");
+  assert.strictEqual(state.intent, null, "intent should be reset after selecting another mission");
+  assert.strictEqual(state.completion, null, "completion should be reset");
+
+  // reset → clean state
+  state = igoReducer(state, { type: "reset" } as Parameters<typeof igoReducer>[1]);
+  assert.strictEqual(state.intent, null, "intent should be null after reset");
+  assert.strictEqual(state.completion, null, "completion should be null after reset");
+  assert.ok(Array.isArray(state.eventLog), "eventLog present after reset");
+
+  // ── Stage 5: Campaign Builder ────────────────────────────────────────────
+
+  // 1. initial campaignDraft exists
+  assert.ok(state.campaignDraft, "campaignDraft should exist on initial state");
+
+  // 2. initial campaignRuleChecks exists and has checks
+  assert.ok(
+    Array.isArray(state.campaignRuleChecks) && state.campaignRuleChecks.length > 0,
+    "campaignRuleChecks should exist and have entries"
+  );
+
+  // 3. initial campaignBudgetSimulation exists
+  assert.ok(state.campaignBudgetSimulation, "campaignBudgetSimulation should exist");
+
+  // 4. update_campaign_draft with invalid title creates a blocking title error
+  state = igoReducer(state, {
+    type: "update_campaign_draft",
+    patch: { title: "" },
+  } as Parameters<typeof igoReducer>[1]);
+  assert.strictEqual(state.campaignDraft?.title, "", "campaignDraft title should be patched to empty");
+  const titleCheckInvalid = state.campaignRuleChecks?.find(
+    (c: IGoCampaignRuleCheck) => c.id === "title"
+  );
+  assert.ok(
+    titleCheckInvalid &&
+      titleCheckInvalid.passed === false &&
+      titleCheckInvalid.severity === "error",
+    "title check should be failing with severity=error"
+  );
+  assert.strictEqual(
+    state.campaignDraft?.status,
+    "invalid",
+    "campaignDraft status should be invalid when blocking errors present"
+  );
+
+  // 5. update_campaign_draft with valid title clears the blocking title error
+  state = igoReducer(state, {
+    type: "update_campaign_draft",
+    patch: { title: "Local Promo" },
+  } as Parameters<typeof igoReducer>[1]);
+  const titleCheckValid = state.campaignRuleChecks?.find(
+    (c: IGoCampaignRuleCheck) => c.id === "title"
+  );
+  assert.ok(
+    titleCheckValid && titleCheckValid.passed === true,
+    "title check should pass after a valid title"
+  );
+  assert.strictEqual(
+    state.campaignDraft?.status,
+    "valid",
+    "campaignDraft status should be valid when no blocking errors"
+  );
+
+  // 6. publish_mock_campaign with a valid draft creates mockPublishedCampaign
+  state = igoReducer(state, {
+    type: "publish_mock_campaign",
+  } as Parameters<typeof igoReducer>[1]);
+  assert.ok(
+    state.mockPublishedCampaign,
+    "mockPublishedCampaign should be present after publishing a valid draft"
+  );
+
+  // 7. publish_mock_campaign adds the generated mission to state.missions
+  const pub = state.mockPublishedCampaign!;
+  assert.ok(
+    state.missions.find((m: IGoMission) => m.id === pub.mission.id),
+    "published mission should be present in state.missions"
+  );
+
+  // 8. publish_mock_campaign selects the generated mission
+  assert.strictEqual(
+    state.selectedMissionId,
+    pub.mission.id,
+    "selectedMissionId should point to the published mission"
+  );
+
+  // 9. selected generated mission can create an intent
+  state = igoReducer(state, { type: "create_intent" } as Parameters<typeof igoReducer>[1]);
+  assert.ok(state.intent, "intent should be creatable for published mission");
+  assert.strictEqual(
+    state.intent!.missionId,
+    state.selectedMissionId,
+    "intent.missionId should match selected mission"
+  );
+
+  // 11. full iGO user flow still works after publishing a mock campaign
+  state = igoReducer(state, { type: "start_mission" } as Parameters<typeof igoReducer>[1]);
+  assert.strictEqual(state.intent!.status, "active", "intent should be active on published mission");
+
+  state = igoReducer(state, { type: "mock_arrival" } as Parameters<typeof igoReducer>[1]);
+  assert.strictEqual(state.intent!.status, "arrived", "intent should be arrived on published mission");
+
+  state = igoReducer(state, { type: "start_verification" } as Parameters<typeof igoReducer>[1]);
+  state = igoReducer(state, { type: "pass_verification" } as Parameters<typeof igoReducer>[1]);
+  assert.strictEqual(
+    state.intent!.rewardStatus,
+    "pending",
+    "rewardStatus should be pending after pass_verification on published mission"
+  );
+
+  state = igoReducer(state, { type: "approve_pending_reward" } as Parameters<typeof igoReducer>[1]);
+  assert.strictEqual(
+    state.intent!.status,
+    "completed",
+    "intent should be completed after approve_pending_reward on published mission"
+  );
+  assert.ok(state.proofPackage, "proofPackage should be created on published mission flow");
+  assert.ok(state.settlementContract, "settlementContract should be created on published mission flow");
+
+  // 10. reset_campaign_draft clears mockPublishedCampaign
+  state = igoReducer(state, { type: "reset_campaign_draft" } as Parameters<typeof igoReducer>[1]);
+  assert.strictEqual(
+    state.mockPublishedCampaign,
+    null,
+    "mockPublishedCampaign should be null after reset_campaign_draft"
+  );
+
+  // 12. publish_mock_campaign with invalid draft does not create mockPublishedCampaign
+  state = igoReducer(state, {
+    type: "update_campaign_draft",
+    patch: { title: "" },
+  } as Parameters<typeof igoReducer>[1]);
+  state = igoReducer(state, {
+    type: "publish_mock_campaign",
+  } as Parameters<typeof igoReducer>[1]);
+  assert.strictEqual(
+    state.mockPublishedCampaign,
+    null,
+    "publish should not create mockPublishedCampaign for an invalid draft"
+  );
+  assert.strictEqual(
+    state.campaignDraft?.status,
+    "invalid",
+    "campaignDraft should be invalid after a failed publish"
+  );
+}
+
+export default runIGoReducerChecks;
