+        <div>
+          <label className="text-xs">Sponsor</label>
+          <input className="w-full p-1 bg-gray-800 rounded mt-1" value={draft.sponsorName} onChange={(e) => onUpdateDraft({ sponsorName: e.target.value })} />
+        </div>
+        <div className="flex gap-2">
+          <div>
+            <label className="text-xs">iCoins</label>
+            <input type="number" className="w-24 p-1 bg-gray-800 rounded mt-1" value={draft.reward.icoinAmount} onChange={(e) => onUpdateDraft({ reward: { ...draft.reward, icoinAmount: Number(e.target.value) } })} />
+          </div>
+          <div>
+            <label className="text-xs">min dwell (s)</label>
+            <input type="number" className="w-24 p-1 bg-gray-800 rounded mt-1" value={draft.minDwellSeconds} onChange={(e) => onUpdateDraft({ minDwellSeconds: Number(e.target.value) })} />
+          </div>
+        </div>
+        <div className="flex gap-2">
+          <button className="px-3 py-1 bg-blue-600 rounded" onClick={onValidate}>Validate draft</button>
+          <button className="px-3 py-1 bg-green-600 rounded" onClick={onPublishMock}>Publish mock campaign</button>
+          <button className="px-3 py-1 bg-gray-700 rounded" onClick={onReset}>Reset draft</button>
+        </div>
+      </div>
+    </div>
+  );
+};
