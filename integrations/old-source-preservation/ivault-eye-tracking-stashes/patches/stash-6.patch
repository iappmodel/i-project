+                    Fail verification (mock)
+                  </button>
+                  <button className="px-4 py-2 bg-yellow-600 rounded" onClick={() => sendManualReview()}>
+                    Send to review
+                  </button>
+                </div>
+              )}
+
+              {intent?.status === "verifying" && intent?.rewardStatus === "pending" && (
+                <div className="flex gap-2">
+                  <div className="px-4 py-2 bg-gray-700 rounded text-sm">Reward pending</div>
+                  <button className="px-4 py-2 bg-green-600 rounded" onClick={() => approvePendingReward()}>
+                    Approve pending reward
+                  </button>
+                  <button className="px-4 py-2 bg-red-600 rounded" onClick={() => rejectPendingReward()}>
+                    Reject pending reward
+                  </button>
+                </div>
+              )}
+
+              {intent && (
+                <button className="px-3 py-1 text-xs bg-gray-700 rounded" onClick={() => reset()}>
+                  Reset demo
+                </button>
+              )}
+            </div>
+          </section>
+
+          {state.completion && (
+            <section className="p-4 bg-gray-800 rounded">
+              <h3 className="text-lg font-semibold">iGO Complete</h3>
+              <div className="text-sm text-gray-300">Presence verified. Reward approved.</div>
+              <div className="mt-3">
+                <div className="text-sm">iCoins: {state.completion.reward.icoinAmount}</div>
+                <div className="text-sm">gCoins: {state.completion.reward.gcoinAmount}</div>
+                <div className="text-sm">Proof: {state.completion.proofId}</div>
+                <div className="text-sm">Trust impact: {state.completion.trustImpact}</div>
+              </div>
+
+              <div className="mt-4">
+                <h4 className="text-sm text-gray-300">Proof summary</h4>
+                <IGoProofSummary
+                  checks={state.intent?.checks ?? []}
+                  proofId={state.completion.proofId}
+                  verificationScore={state.intent?.verificationScore}
+                  rewardStatus={state.intent?.rewardStatus}
+                />
+              </div>
+            </section>
+          )}
+
+          {/* Proof package & settlement panels */}
+          <section className="p-4 bg-gray-900 rounded space-y-4">
+            <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
+              <div className="md:col-span-1">
+                <IGoProofPackagePanel proofPackage={state.proofPackage ?? null} />
+              </div>
+              <div className="md:col-span-1">
+                <IGoSettlementPanel settlementContract={state.settlementContract ?? null} onMockSettle={() => markMockSettled()} />
+              </div>
+              <div className="md:col-span-1">
+                <IGoProofJsonPreview proofPackage={state.proofPackage ?? null} settlementContract={state.settlementContract ?? null} />
+              </div>
+            </div>
+          </section>
+
+          {/* Owner / audit view (local mock) */}
+          <section className="p-4 bg-gray-900 rounded space-y-4">
+            <h3 className="text-lg font-semibold">Owner / audit view (local mock)</h3>
+            <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
+              <div className="md:col-span-1">
+                <IGoOwnerSummaryPanel summary={state.ownerSummary ?? null} />
+              </div>
+              <div className="md:col-span-1">
+                <IGoAuditTable records={state.auditRecords ?? []} selectedRecordId={state.selectedAuditRecordId ?? null} onSelectRecord={(id) => selectAuditRecord(id)} />
+              </div>
+              <div className="md:col-span-1">
+                <IGoAuditRecordPanel
+                  record={(state.auditRecords ?? []).find((r) => r.id === state.selectedAuditRecordId) ?? null}
+                  onQueueReview={() => queueRiskReview()}
+                  onClearReview={() => clearRiskReview()}
+                  onBlockReview={() => blockRiskReview()}
+                  onClose={() => clearAuditSelection()}
+                />
+              </div>
+            </div>
+          </section>
+
+          {/* Campaign builder */}
+          <section className="p-4 bg-gray-900 rounded space-y-4">
+            <h3 className="text-lg font-semibold">Campaign builder (local mock)</h3>
+            <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
+              <div className="md:col-span-1">
+                <IGoCampaignBuilderPanel draft={state.campaignDraft ?? null} onUpdateDraft={(p) => updateCampaignDraft(p)} onValidate={() => validateCampaignDraft()} onPublishMock={() => publishMockCampaign()} onReset={() => resetCampaignDraft()} />
+              </div>
+              <div className="md:col-span-1">
+                <IGoCampaignRulesPanel checks={state.campaignRuleChecks ?? []} />
+                <div className="mt-3">
+                  <IGoCampaignBudgetPanel simulation={state.campaignBudgetSimulation ?? null} />
+                </div>
+              </div>
+              <div className="md:col-span-1">
+                <IGoMockPublishedCampaignPanel campaign={state.mockPublishedCampaign ?? null} />
+              </div>
+            </div>
+          </section>
+
+          {/* verification gates & timer & event log */}
+          {intent && (
+            <section className="p-4 bg-gray-900 rounded">
+              {typeof intent.remainingSeconds === "number" && (
+                <div className="mb-3">
+                  <IGoMissionTimer remainingSeconds={intent.remainingSeconds} totalSeconds={selectedMission.timeLimitMinutes * 60} />
+                </div>
+              )}
+
+              {intent.gates && intent.gates.length > 0 && (
+                <div className="mb-3">
+                  <IGoVerificationGates gates={intent.gates} />
+                </div>
+              )}
+
+              <div>
+                <IGoEventLog items={state.eventLog} />
+              </div>
+            </section>
+          )}
+        </main>
+      </div>
+    </div>
+  );
+}
+
