index 0000000..7fa78d2
--- /dev/null
+++ b/src/lib/igo/igo-audit.ts
@@ -0,0 +1,102 @@
+import type {
+  IGoMission,
+  IGoIntent,
+  IGoProofPackage,
+  IGoSettlementContract,
+  IGoAuditRecord,
+  IGoCampaignOwnerSummary,
+  IGoRiskReviewStatus
+} from "./igo.types";
+
+import { createLocalIntegrityId } from "./igo-proof";
+
+export function createIGoAuditRecord(input: {
+  mission: IGoMission;
+  intent: IGoIntent;
+  proofPackage?: IGoProofPackage | null;
+  settlementContract?: IGoSettlementContract | null;
+  userLabel?: string;
+}): IGoAuditRecord {
+  const { mission, intent, proofPackage, settlementContract, userLabel } = input;
+  const outcome = proofPackage?.outcome ?? (intent.rewardStatus === "manual_review" ? "manual_review" : intent.rewardStatus === "approved" ? "approved" : "rejected");
+  let auditStatus: IGoAuditRecord["auditStatus"] = "clean";
+  if (outcome === "approved" && settlementContract?.status === "ready") auditStatus = "settlement_ready";
+  else if (outcome === "approved" && settlementContract?.status === "mock_settled") auditStatus = "mock_settled";
+  else if (outcome === "manual_review") auditStatus = "needs_review";
+  else if (outcome === "rejected" || outcome === "expired") auditStatus = "rejected";
+
+  let riskReviewStatus: IGoRiskReviewStatus = "not_required";
+  if (outcome === "manual_review") riskReviewStatus = "queued";
+  else if (outcome === "rejected") riskReviewStatus = "blocked";
+
+  const record: IGoAuditRecord = {
+    id: `audit-${Date.now()}-${Math.random().toString(36).slice(2, 6)}`,
+    missionId: mission.id,
+    intentId: intent.id,
+    proofPackageId: proofPackage?.id,
+    settlementContractId: settlementContract?.id,
+    userLabel: userLabel ?? "Mock user",
+    placeName: mission.place.name,
+    outcome: (proofPackage?.outcome ?? (intent.rewardStatus === "manual_review" ? "manual_review" : (intent.rewardStatus as any))) as any,
+    rewardStatus: intent.rewardStatus ?? "none",
+    settlementStatus: settlementContract?.status ?? "not_ready",
+    auditStatus,
+    riskReviewStatus,
+    verificationScore: intent.verificationScore ?? 0,
+    localIntegrityId: proofPackage?.localIntegrityId,
+    createdAtLabel: "Just now"
+  };
+
+  return record;
+}
+
+export function createIGoCampaignOwnerSummary(input: {
+  mission: IGoMission;
+  records: IGoAuditRecord[];
+}): IGoCampaignOwnerSummary {
+  const { mission, records } = input;
+  const completions = records.length;
+  const approvals = records.filter((r) => r.outcome === "approved").length;
+  const rejections = records.filter((r) => r.outcome === "rejected" || r.outcome === "expired").length;
+  const manualReviews = records.filter((r) => r.outcome === "manual_review").length;
+  const mockSettlements = records.filter((r) => r.settlementStatus === "mock_settled").length;
+  const avgScore = records.length === 0 ? 0 : Math.round(records.reduce((s, r) => s + (r.verificationScore || 0), 0) / records.length);
+  const spent = approvals * (mission.reward.icoinAmount || 0);
+  const pending = manualReviews * (mission.reward.icoinAmount || 0);
+  const total = 500; // mock total in iCoins
+  const remaining = total - spent;
+
+  return {
+    campaignId: `campaign-${mission.id}`,
+    missionId: mission.id,
+    sponsorName: mission.sponsorName,
+    placeName: mission.place.name,
+    campaignType: mission.campaignType,
+    totalBudgetLabel: `$${(total / 100).toFixed(2)}`,
+    spentLabel: `${spent} iCoins`,
+    pendingLabel: `${pending} iCoins`,
+    remainingLabel: `${remaining} iCoins`,
+    completions,
+    approvals,
+    rejections,
+    manualReviews,
+    mockSettlements,
+    averageVerificationScore: avgScore
+  };
+}
+
+export function updateAuditRecordForSettlement(record: IGoAuditRecord): IGoAuditRecord {
+  if (record.settlementStatus === "ready") {
+    return { ...record, settlementStatus: "mock_settled", auditStatus: "mock_settled" };
+  }
+  return record;
+}
+
+export function updateAuditRecordRiskStatus(record: IGoAuditRecord, status: IGoRiskReviewStatus): IGoAuditRecord {
+  const newRecord = { ...record, riskReviewStatus: status };
+  if (status === "blocked") {
+    newRecord.auditStatus = "rejected";
+  }
+  return newRecord;
+}
+
diff --git a/src/lib/igo/igo-campaign-builder.ts b/src/lib/igo/igo-campaign-builder.ts
new file mode 100644
index 0000000..0793319
--- /dev/null
+++ b/src/lib/igo/igo-campaign-builder.ts
@@ -0,0 +1,120 @@
+import type {
+  IGoCampaignDraft,
+  IGoMission,
+  IGoCampaignRuleCheck,
+  IGoCampaignBudgetSimulation,
+  IGoMockPublishedCampaign,
+  IGoCampaignDraftStatus
+} from "./igo.types";
+import { IGO_MOCK_MISSIONS } from "./igo.mock";
+
+// Note: we avoid adding new dependencies. Implement helpers locally.
+export function createInitialIGoCampaignDraft(mission?: IGoMission): IGoCampaignDraft {
+  const seed = mission ?? IGO_MOCK_MISSIONS[0];
+  return {
+    id: `draft-${Date.now()}-${Math.random().toString(36).slice(2, 6)}`,
+    status: "draft",
+    title: seed.title,
+    description: seed.description,
+    sponsorName: seed.sponsorName,
+    creatorHandle: seed.creatorHandle,
+    campaignType: seed.campaignType,
+    place: seed.place,
+    reward: seed.reward,
+    minDwellSeconds: Math.max(30, seed.minDwellSeconds),
+    timeLimitMinutes: Math.max(15, seed.timeLimitMinutes),
+    requiredVerificationLevel: seed.requiredVerificationLevel,
+    maxCompletions: 100,
+    maxCompletionsPerUser: 1,
+    budgetMode: "fixed_total",
+    totalBudgetAmount: 500,
+    startsAtLabel: seed.startsAtLabel,
+    endsAtLabel: seed.endsAtLabel,
+    isMockPublished: false
+  };
+}
+
+export function validateIGoCampaignDraft(draft: IGoCampaignDraft): IGoCampaignRuleCheck[] {
+  const checks: IGoCampaignRuleCheck[] = [];
+  if (!draft.title || draft.title.trim().length === 0) checks.push({ id: "title", label: "Title required", detail: "Campaign title is required", severity: "error", passed: false });
+  else checks.push({ id: "title", label: "Title", detail: "Title present", severity: "info", passed: true });
+  if (!draft.sponsorName || draft.sponsorName.trim().length === 0) checks.push({ id: "sponsor", label: "Sponsor required", detail: "Sponsor name is required", severity: "error", passed: false });
+  else checks.push({ id: "sponsor", label: "Sponsor", detail: "Sponsor present", severity: "info", passed: true });
+  if (!(draft.reward.icoinAmount > 0)) checks.push({ id: "reward-icoin", label: "iCoin reward > 0", detail: "iCoin reward must be > 0", severity: "error", passed: false });
+  else checks.push({ id: "reward-icoin", label: "iCoin reward", detail: "iCoin ok", severity: "info", passed: true });
+  if (draft.minDwellSeconds < 30) checks.push({ id: "dwell", label: "minDwellSeconds", detail: "Recommended >= 30s", severity: "warning", passed: false }); else checks.push({ id: "dwell", label: "minDwellSeconds", detail: "OK", severity: "info", passed: true });
+  if (draft.timeLimitMinutes < 15) checks.push({ id: "time", label: "timeLimitMinutes", detail: "Recommended >= 15m", severity: "warning", passed: false }); else checks.push({ id: "time", label: "timeLimitMinutes", detail: "OK", severity: "info", passed: true });
+  if (draft.maxCompletions <= 0) checks.push({ id: "max", label: "maxCompletions", detail: "Must be > 0", severity: "error", passed: false }); else checks.push({ id: "max", label: "maxCompletions", detail: "OK", severity: "info", passed: true });
+  if (draft.maxCompletionsPerUser < 1) checks.push({ id: "per-user", label: "maxCompletionsPerUser", detail: "Must be >= 1", severity: "error", passed: false }); else checks.push({ id: "per-user", label: "maxCompletionsPerUser", detail: "OK", severity: "info", passed: true });
+  if (draft.budgetMode === "fixed_total") {
+    const afford = Math.floor(draft.totalBudgetAmount / Math.max(1, draft.reward.icoinAmount));
+    if (afford < 1) checks.push({ id: "budget", label: "totalBudgetAmount", detail: "Budget does not cover a single reward", severity: "error", passed: false }); else checks.push({ id: "budget", label: "totalBudgetAmount", detail: "Budget OK", severity: "info", passed: true });
+  }
+  if (draft.requiredVerificationLevel >= 3) checks.push({ id: "verification-level", label: "verification level", detail: "High verification recommended", severity: "info", passed: true });
+  return checks;
+}
+
+export function simulateIGoCampaignBudget(draft: IGoCampaignDraft): IGoCampaignBudgetSimulation {
+  const total = draft.totalBudgetAmount;
+  const reward = draft.reward.icoinAmount || 1;
+  const maxAffordable = reward > 0 ? Math.floor(total / reward) : 0;
+  const configured = draft.maxCompletions;
+  const take = Math.min(maxAffordable, configured);
+  const estimatedSpend = take * reward;
+  const remaining = total - estimatedSpend;
+  const pctRemaining = total > 0 ? remaining / total : 0;
+  const risk: "low" | "medium" | "high" = maxAffordable < configured ? "high" : pctRemaining < 0.2 ? "medium" : "low";
+  return {
+    totalBudgetLabel: `$${(total / 100).toFixed(2)}`,
+    rewardPerCompletionLabel: `${reward} iCoins`,
+    maxAffordableCompletions: maxAffordable,
+    configuredMaxCompletions: configured,
+    estimatedSpendLabel: `${estimatedSpend} iCoins`,
+    estimatedRemainingLabel: `${remaining} iCoins`,
+    budgetRisk: risk
+  };
+}
+
+// createMissionFromCampaignDraft - simplified mapping
+export function createMissionFromCampaignDraft(draft: IGoCampaignDraft): IGoMission {
+  // minimal mission scaffold
+  return {
+    id: `mock-mission-${draft.id}`,
+    campaignType: draft.campaignType,
+    title: draft.title,
+    description: draft.description,
+    sponsorName: draft.sponsorName,
+    creatorHandle: draft.creatorHandle,
+    place: draft.place,
+    reward: draft.reward,
+    requirements: [],
+    minDwellSeconds: draft.minDwellSeconds,
+    timeLimitMinutes: draft.timeLimitMinutes,
+    startsAtLabel: draft.startsAtLabel,
+    endsAtLabel: draft.endsAtLabel,
+    riskLevel: "medium",
+    requiredVerificationLevel: draft.requiredVerificationLevel,
+    status: "available"
+  } as IGoMission;
+}
+
+export function createMockPublishedCampaign(input: { draft: IGoCampaignDraft; ruleChecks: IGoCampaignRuleCheck[]; budgetSimulation: IGoCampaignBudgetSimulation; }): IGoMockPublishedCampaign {
+  const mission = createMissionFromCampaignDraft(input.draft);
+  return {
+    id: `mockpub-${Date.now()}`,
+    draftId: input.draft.id,
+    mission,
+    publishedAtLabel: "Just now",
+    ruleChecks: input.ruleChecks,
+    budgetSimulation: input.budgetSimulation
+  };
+}
+
+export function hasBlockingCampaignErrors(ruleChecks: IGoCampaignRuleCheck[]): boolean {
+  return ruleChecks.some((c) => c.severity === "error" && !c.passed);
+}
+
+export function formatMockMoney(amount: number): string {
+  return `$${(amount / 100).toFixed(2)}`;
+}
+
