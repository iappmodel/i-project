+++ b/src/components/igo/IGoMissionTimer.tsx
@@ -0,0 +1,32 @@
+import React from "react";
+
+type Props = {
+  remainingSeconds: number;
+  totalSeconds: number;
+};
+
+function formatSeconds(s: number) {
+  const mm = Math.floor(s / 60)
+    .toString()
+    .padStart(2, "0");
+  const ss = Math.max(0, Math.floor(s % 60))
+    .toString()
+    .padStart(2, "0");
+  return `${mm}:${ss}`;
+}
+
+export const IGoMissionTimer: React.FC<Props> = ({ remainingSeconds, totalSeconds }) => {
+  const pct = totalSeconds > 0 ? Math.round(((totalSeconds - remainingSeconds) / totalSeconds) * 100) : 0;
+  return (
+    <div className="p-3 bg-gray-900 rounded">
+      <div className="text-sm font-semibold text-white">Mock mission timer</div>
+      <div className="mt-2 text-xs text-gray-300">{formatSeconds(remainingSeconds)}</div>
+      <div className="h-2 bg-gray-800 rounded mt-2">
+        <div style={{ width: `${pct}%` }} className="h-2 bg-green-500 rounded" />
+      </div>
+    </div>
+  );
+};
+
+export default IGoMissionTimer;
+
