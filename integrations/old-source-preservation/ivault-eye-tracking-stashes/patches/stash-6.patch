+import React from "react";
+import { useIGoState } from "../lib/igo/igo-state";
+import IGoMissionCard from "../components/igo/IGoMissionCard";
+import IGoRequirementList from "../components/igo/IGoRequirementList";
+import IGoProgressSteps from "../components/igo/IGoProgressSteps";
+import IGoTrustBadge from "../components/igo/IGoTrustBadge";
+import IGoRewardBadge from "../components/igo/IGoRewardBadge";
+import IGoProofSummary from "../components/igo/IGoProofSummary";
+import IGoEventLog from "../components/igo/IGoEventLog";
+import IGoVerificationGates from "../components/igo/IGoVerificationGates";
+import IGoMissionTimer from "../components/igo/IGoMissionTimer";
+import IGoProofPackagePanel from "../components/igo/IGoProofPackagePanel";
+import IGoSettlementPanel from "../components/igo/IGoSettlementPanel";
+import IGoProofJsonPreview from "../components/igo/IGoProofJsonPreview";
+import IGoOwnerSummaryPanel from "../components/igo/IGoOwnerSummaryPanel";
+import IGoAuditTable from "../components/igo/IGoAuditTable";
+import IGoAuditRecordPanel from "../components/igo/IGoAuditRecordPanel";
+import IGoCampaignBuilderPanel from "../components/igo/IGoCampaignBuilderPanel";
+import IGoCampaignRulesPanel from "../components/igo/IGoCampaignRulesPanel";
+import IGoCampaignBudgetPanel from "../components/igo/IGoCampaignBudgetPanel";
+import IGoMockPublishedCampaignPanel from "../components/igo/IGoMockPublishedCampaignPanel";
+import { getIGoStatusLabel, getIGoStatusDescription } from "../lib/igo/igo-copy";
+
+export default function IGoScreen() {
+  const {
+    state,
+    selectedMission,
+    progressSteps,
+    selectMission,
+    createIntent,
+    startMission,
+    mockArrival,
+    startVerification,
+    passVerification,
+    failVerification,
+    sendManualReview,
+    approvePendingReward,
+    rejectPendingReward,
+    tickTimer,
+    markMockSettled,
+    reset,
+    selectAuditRecord,
+    clearAuditSelection,
+    queueRiskReview,
+    clearRiskReview,
+    blockRiskReview,
+    updateCampaignDraft,
+    validateCampaignDraft,
+    publishMockCampaign,
+    resetCampaignDraft
+  } = useIGoState();
+
+  const intent = state.intent;
+
+  // simple interval for ticking timer while active
+  React.useEffect(() => {
+    const iv = setInterval(() => tickTimer(), 1000);
+    return () => clearInterval(iv);
+  }, [tickTimer]);
+
+  return (
+    <div className="min-h-screen p-6 bg-black text-white">
+      <header className="mb-6">
+        <h1 className="text-2xl font-bold">[ i ] iGO</h1>
+        <p className="text-sm text-gray-400">Verified movement. Real-world rewards.</p>
+        <div className="mt-2 text-xs text-gray-300">Wallet-ready rewards</div>
+      </header>
+
+      <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
+        <aside className="md:col-span-1 space-y-4">
+          <div className="text-sm text-gray-300">Available Missions</div>
+          <div className="space-y-3">
+            {state.missions.map((m) => (
+              <IGoMissionCard
+                key={m.id}
+                mission={m}
+                selected={m.id === selectedMission.id}
+                onSelect={() => selectMission(m.id)}
+              />
+            ))}
+          </div>
+        </aside>
+
+        <main className="md:col-span-2 space-y-6">
+          <section className="p-4 bg-gray-900 rounded">
+            <div className="flex items-start justify-between">
+              <div>
+                <h2 className="text-xl font-semibold">{selectedMission.title}</h2>
+                <div className="text-sm text-gray-400">{selectedMission.description}</div>
+                <div className="mt-2 text-xs text-gray-400">
+                  Sponsor: {selectedMission.sponsorName}{" "}
+                  {selectedMission.creatorHandle ? `· ${selectedMission.creatorHandle}` : ""}
+                </div>
+              </div>
+              <div className="space-y-2">
+                <IGoRewardBadge
+                  icoinAmount={selectedMission.reward.icoinAmount}
+                  gcoinAmount={selectedMission.reward.gcoinAmount}
+                  usdLabel={selectedMission.reward.estimatedUsdLabel}
+                />
+                <IGoTrustBadge level={selectedMission.place.trustTier} riskLabel={`${selectedMission.riskLevel} risk`} />
+              </div>
+            </div>
+
+            <div className="mt-4 grid grid-cols-1 md:grid-cols-2 gap-4">
+              <div>
+                <h3 className="text-sm text-gray-300">Place</h3>
+                <div className="font-medium">{selectedMission.place.name}</div>
+                <div className="text-xs text-gray-400">{selectedMission.place.address}</div>
+                <div className="text-xs text-gray-400">{selectedMission.place.openUntilLabel}</div>
+              </div>
+
+              <div>
+                <h3 className="text-sm text-gray-300">Verification</h3>
+                <div className="text-sm">{getIGoStatusLabel(selectedMission.status)}</div>
+                <div className="text-xs text-gray-400">{getIGoStatusDescription(selectedMission.status)}</div>
+                <div className="mt-2 text-xs text-gray-400">Verification level: {selectedMission.requiredVerificationLevel}</div>
+                <div className="mt-1 text-xs text-gray-400">
+                  Window: {selectedMission.startsAtLabel} — {selectedMission.endsAtLabel}
+                </div>
+              </div>
+            </div>
+
+            <div className="mt-4">
+              <h4 className="text-sm text-gray-300">Requirements</h4>
+              <IGoRequirementList requirements={selectedMission.requirements} />
+            </div>
+          </section>
+
+          <section className="p-4 bg-gray-900 rounded">
+            <h4 className="text-sm text-gray-300">Progress</h4>
+            <IGoProgressSteps steps={progressSteps} />
+
+            <div className="mt-4 flex items-center gap-3">
+              {!intent && (
+                <button className="px-4 py-2 bg-blue-600 rounded" onClick={() => createIntent()}>
+                  I'm Going
+                </button>
+              )}
+
+              {intent?.status === "reserved" && (
+                <button className="px-4 py-2 bg-blue-600 rounded" onClick={() => startMission()}>
+                  Start iGO
+                </button>
+              )}
+
+              {intent?.status === "active" && (
+                <button className="px-4 py-2 bg-yellow-600 rounded" onClick={() => mockArrival()}>
+                  Mock arrival
+                </button>
+              )}
+
+              {intent?.status === "arrived" && (
+                <button className="px-4 py-2 bg-indigo-600 rounded" onClick={() => startVerification()}>
+                  Verify presence (mock)
+                </button>
+              )}
+
+              {intent?.status === "verifying" && intent?.rewardStatus !== "pending" && (
+                <div className="flex gap-2">
+                  <button className="px-4 py-2 bg-green-600 rounded" onClick={() => passVerification()}>
+                    Pass verification (mock)
+                  </button>
