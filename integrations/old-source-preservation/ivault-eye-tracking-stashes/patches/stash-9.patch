+  detail?: string;
+  createdAtLabel: string;
+};
+
+// Stage 3: proof and settlement types
+export type IGoProofOutcome =
+  | "approved"
+  | "rejected"
+  | "manual_review"
+  | "expired";
+
+export type IGoProofPackage = {
+  id: string;
+  missionId: string;
+  intentId: string;
+  outcome: IGoProofOutcome;
+  createdAtLabel: string;
+  placeSnapshot: {
+    placeId: string;
+    name: string;
+    address: string;
+    city: string;
+    distanceLabel: string;
+    geofenceRadiusMeters: number;
+  };
+  rewardSnapshot: IGoReward;
+  gateSnapshot: IGoVerificationGate[];
+  checksSnapshot: IGoPresenceCheck[];
+  verificationScore: number;
+  rewardStatus: IGoRewardStatus;
+  trustImpact: number;
+  localIntegrityId: string;
+  notes: string[];
+};
+
+export type IGoSettlementStatus =
+  | "not_ready"
+  | "ready"
+  | "blocked"
+  | "mock_settled";
+
+export type IGoSettlementContract = {
+  id: string;
+  proofPackageId: string;
+  missionId: string;
+  intentId: string;
+  status: IGoSettlementStatus;
+  userCredit: {
+    icoinAmount: number;
+    gcoinAmount: number;
+    estimatedUsdLabel: string;
+  };
+  creatorCredit?: {
+    handle: string;
+    icoinAmount: number;
+  };
+  platformFee?: {
+    icoinAmount: number;
+  };
+  walletLedgerMode: "mock_only";
+  settlementNote: string;
+  createdAtLabel: string;
+};
+
