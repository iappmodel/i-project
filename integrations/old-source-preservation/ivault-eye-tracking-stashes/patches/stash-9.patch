+  return (
+    <div className="p-3 bg-gray-900 rounded">
+      <div className="text-sm font-semibold text-white">Mock settlement contract</div>
+      <div className="mt-2 text-xs text-gray-300">
+        <div><strong>ID:</strong> {settlementContract.id}</div>
+        <div><strong>Status:</strong> {settlementContract.status}</div>
+        <div><strong>User credit:</strong> {settlementContract.userCredit.icoinAmount} iCoins</div>
+        {settlementContract.creatorCredit && <div><strong>Creator:</strong> {settlementContract.creatorCredit.handle} ({settlementContract.creatorCredit.icoinAmount} iCoins)</div>}
+        {settlementContract.platformFee && <div><strong>Platform fee:</strong> {settlementContract.platformFee.icoinAmount} iCoins</div>}
+        <div className="mt-2 text-xs text-gray-400">{settlementContract.settlementNote}</div>
+        <div className="mt-3">
+          {settlementContract.status === "ready" && onMockSettle && (
+            <button className="px-3 py-1 bg-green-600 rounded" onClick={onMockSettle}>Mark mock settled</button>
+          )}
+          {settlementContract.status === "mock_settled" && <div className="text-sm text-green-400">Mock settled — no wallet ledger mutation performed.</div>}
+        </div>
+      </div>
+    </div>
+  );
+};
