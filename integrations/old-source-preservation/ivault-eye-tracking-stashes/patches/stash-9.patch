+import React from "react";
+import type { IGoPresenceCheck } from "../../lib/igo/igo.types";
+import { getIGoMethodLabel } from "../../lib/igo/igo-copy";
+
+type IGoProofSummaryProps = {
+  checks: IGoPresenceCheck[];
+  proofId?: string;
+  verificationScore?: number;
+  rewardStatus?: string;
+};
+
+export const IGoProofSummary: React.FC<IGoProofSummaryProps> = ({ checks, proofId, verificationScore, rewardStatus }) => {
+  return (
+    <div className="space-y-3">
+      <div className="text-xs text-gray-400">Verification score: {typeof verificationScore === "number" ? verificationScore : "-"}</div>
+      <div className="text-xs text-gray-400">Reward status: {rewardStatus ?? "-"}</div>
+      {proofId && (
+        <div className="text-sm text-gray-300">
+          <strong>Proof:</strong> {proofId}
+        </div>
+      )}
+
+      <ul className="space-y-2">
+        {checks.map((c) => (
+          <li key={c.id} className="p-2 bg-gray-900 rounded flex items-center justify-between">
+            <div>
+              <div className="font-medium text-white">{c.label}</div>
+              <div className="text-xs text-gray-400">{getIGoMethodLabel(c.method)}</div>
+            </div>
+            <div className="text-right">
+              <div className={`text-sm ${c.result === "pass" ? "text-green-400" : "text-red-400"}`}>
+                {c.result.toUpperCase()}
+              </div>
+              {typeof c.riskScore === "number" && (
+                <div className="text-xs text-gray-400">Risk: {c.riskScore}</div>
+              )}
+            </div>
+          </li>
+        ))}
+      </ul>
+    </div>
+  );
+};
+
+export default IGoProofSummary;
