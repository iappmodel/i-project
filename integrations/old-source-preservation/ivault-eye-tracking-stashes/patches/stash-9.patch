diff --git a/src/lib/igo/__tests__/igo.reducer.test.ts b/src/lib/igo/__tests__/igo.reducer.test.ts
new file mode 100644
index 0000000..0b668f0
--- /dev/null
+++ b/src/lib/igo/__tests__/igo.reducer.test.ts
@@ -0,0 +1,91 @@
+import assert from "assert";
+import { igoReducer, createInitialIGoState } from "../igo-state";
+import { IGO_DEFAULT_MISSION_ID, IGO_MOCK_MISSIONS } from "../igo.mock";
+
+// This is a TypeScript-only verification module for the iGO reducer/state flow.
+// No test runner is required to keep this file - it's designed so a test runner
+// (vitest/jest) can import and run it, or a maintainer can run it manually.
+export function runIGoReducerChecks(): void {
+  let state = createInitialIGoState();
+
+  // initial selected mission is the default mission
+  assert.strictEqual(
+    state.selectedMissionId,
+    IGO_DEFAULT_MISSION_ID,
+    "initial selectedMissionId should be the default"
+  );
+
+  // event log empty initially
+  assert.ok(Array.isArray(state.eventLog) && state.eventLog.length === 0, "eventLog should start empty");
+
+  // createIntent creates reserved intent
+  state = igoReducer(state, { type: "create_intent" } as any);
+  assert.ok(state.intent, "intent should exist after create_intent");
+  assert.strictEqual(state.intent!.status, "reserved", "intent should be reserved");
+  assert.strictEqual(state.completion, null, "completion should be null after create_intent");
+  assert.ok(Array.isArray(state.intent!.gates), "gates array should exist on intent (may be empty)");
+  assert.strictEqual(typeof state.intent!.remainingSeconds, "number", "remainingSeconds should be set");
+
+  // startMission changes status to active
+  state = igoReducer(state, { type: "start_mission" } as any);
+  assert.strictEqual(state.intent!.status, "active", "intent should be active after start_mission");
+
+  // mockArrival changes status to arrived and sets dwellSeconds
+  const selectedMissionBefore = state.missions.find((m) => m.id === state.selectedMissionId)!;
+  state = igoReducer(state, { type: "mock_arrival" } as any);
+  assert.strictEqual(state.intent!.status, "arrived", "intent should be arrived after mock_arrival");
+  assert.strictEqual(
+    state.intent!.dwellSeconds,
+    selectedMissionBefore.minDwellSeconds,
+    "dwellSeconds should equal mission.minDwellSeconds after mock_arrival"
+  );
+
+  // startVerification changes status to verifying and creates passing checks
+  state = igoReducer(state, { type: "start_verification" } as any);
+  assert.strictEqual(state.intent!.status, "verifying", "intent should be verifying after start_verification");
+  assert.ok(Array.isArray(state.intent!.gates) && state.intent!.gates.length > 0, "gates should be present");
+  assert.ok(state.intent!.gates.some((g) => g.status === "checking"), "at least some gates should be checking");
+
+  // pass_verification changes gates to passed and reward becomes pending
+  state = igoReducer(state, { type: "pass_verification" } as any);
+  assert.strictEqual(state.intent!.rewardStatus, "pending", "rewardStatus should be pending after pass_verification");
+  assert.ok(state.intent!.gates && state.intent!.gates.every((g) => g.status === "passed" || !g.required), "required gates should be passed");
+
+  // approve pending reward -> completed + completion created
+  state = igoReducer(state, { type: "approve_pending_reward" } as any);
+  assert.strictEqual(state.intent!.status, "completed", "intent should be completed after approve_pending_reward");
+  assert.ok(state.completion, "completion should be present after approve_pending_reward");
+  assert.strictEqual(state.completion!.approved, true, "completion.approved should be true");
+  // proof package and settlement should be created and settlement ready
+  assert.ok(state.proofPackage, "proofPackage should be present after approve_pending_reward");
+  assert.ok(state.settlementContract, "settlementContract should be present after approve_pending_reward");
+  if (state.settlementContract) {
+    assert.ok(["ready", "not_ready", "blocked"].includes(state.settlementContract.status), "settlement status expected");
+  }
+
+  // mark mock settled when ready
+  const prevStatus = state.settlementContract?.status;
+  state = igoReducer(state, { type: "mark_mock_settled" } as any);
+  if (prevStatus === "ready") {
+    assert.strictEqual(state.settlementContract!.status, "mock_settled", "settlement should be mock_settled when previously ready");
+  } else {
+    // if not ready, status should remain unchanged
+    assert.strictEqual(state.settlementContract!.status, prevStatus, "settlement status unchanged if not ready");
+  }
+
+  // selecting another mission resets intent and completion
+  const otherMission = IGO_MOCK_MISSIONS.find((m) => m.id !== state.selectedMissionId) ?? IGO_MOCK_MISSIONS[0];
+  state = igoReducer(state, { type: "select_mission", missionId: otherMission.id } as any);
+  assert.strictEqual(state.selectedMissionId, otherMission.id, "selectedMissionId should update");
+  assert.strictEqual(state.intent, null, "intent should be reset after selecting another mission");
+  assert.strictEqual(state.completion, null, "completion should be reset after selecting another mission");
+  // reset returns clean state
+  state = igoReducer(state, { type: "reset" } as any);
+  assert.strictEqual(state.intent, null, "intent should be null after reset");
+  assert.strictEqual(state.completion, null, "completion should be null after reset");
+  assert.ok(Array.isArray(state.eventLog) && state.eventLog.length >= 0, "eventLog present after reset");
+}
+
+// Export a default for easier importing in future test runners.
+export default runIGoReducerChecks;
+
