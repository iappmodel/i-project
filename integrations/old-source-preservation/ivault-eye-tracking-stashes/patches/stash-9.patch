@@ -0,0 +1,499 @@
+import { useMemo, useReducer } from "react";
+import type {
+  IGoCompletion,
+  IGoIntent,
+  IGoMission,
+  IGoEventLogItem,
+  IGoVerificationGate,
+  IGoRewardStatus,
+  IGoProofPackage,
+  IGoSettlementContract
+} from "./igo.types";
+import { IGO_DEFAULT_MISSION_ID, IGO_MOCK_MISSIONS } from "./igo.mock";
+import {
+  createInitialIntent,
+  createMockPresenceChecks,
+  getIGoProgressSteps
+  } from "./igo-verification";
+import {
+  createVerificationGates,
+  startAllVerificationGates,
+  passAllVerificationGates,
+  failFirstVerificationGate,
+  reviewVerificationGates,
+  createPresenceChecksFromGates,
+  calculateGateScore
+} from "./igo-verification";
+import { createIGoProofPackage, createIGoSettlementContract } from "./igo-proof";
+
+type IGoState = {
+  missions: IGoMission[];
+  selectedMissionId: string;
+  intent: IGoIntent | null;
+  completion: IGoCompletion | null;
+  eventLog: IGoEventLogItem[];
+  proofPackage?: IGoProofPackage | null;
+  settlementContract?: IGoSettlementContract | null;
+};
+
+type IGoAction =
+  | { type: "select_mission"; missionId: string }
+  | { type: "create_intent" }
+  | { type: "start_mission" }
+  | { type: "mock_arrival" }
+  | { type: "start_verification" }
+  | { type: "pass_verification" }
+  | { type: "fail_verification" }
+  | { type: "send_manual_review" }
+  | { type: "approve_pending_reward" }
+  | { type: "reject_pending_reward" }
+  | { type: "tick_timer" }
+  | { type: "reset" }
+  | { type: "mark_mock_settled" };
+
+function makeInitialState(): IGoState {
+  return {
+    missions: IGO_MOCK_MISSIONS,
+    selectedMissionId: IGO_DEFAULT_MISSION_ID,
+    intent: null,
+    completion: null,
+    eventLog: []
+    ,proofPackage: null,
+    settlementContract: null
+  };
+}
+const initialState: IGoState = makeInitialState();
+
+function getSelectedMission(state: IGoState): IGoMission {
+  return (
+    state.missions.find((mission) => mission.id === state.selectedMissionId) ??
+    state.missions[0]
+  );
+}
+
+function reducer(state: IGoState, action: IGoAction): IGoState {
+  const selectedMission = getSelectedMission(state);
+
+  switch (action.type) {
+    case "select_mission":
+      return {
+        ...state,
+        selectedMissionId: action.missionId,
+        intent: null,
+        completion: null
+      };
+
+    case "create_intent":
+      return {
+        ...state,
+        intent: {
+          ...createInitialIntent(selectedMission),
+          rewardStatus: "none",
+          gates: [], // will be created on start or immediately
+          remainingSeconds: selectedMission.timeLimitMinutes * 60,
+          verificationScore: 0
+        },
+        completion: null,
+        eventLog: [
+          {
+            id: `evt-${Date.now()}`,
+            type: "intent_created",
+            label: "Intent created",
+            detail: selectedMission.title,
+            createdAtLabel: "Just now"
+          },
+          ...state.eventLog
+        ]
+      };
+
+    case "start_mission":
+      if (!state.intent) return state;
+
+      return {
+        ...state,
+        intent: {
+          ...state.intent,
+          status: "active",
+          startedAtLabel: "Just now",
+          progressPercent: 40
+        }
+      };
+
+    case "mock_arrival":
+      if (!state.intent) return state;
+
+      return {
+        ...state,
+        intent: {
+          ...state.intent,
+          status: "arrived",
+          arrivedAtLabel: "Just now",
+          progressPercent: 60,
+          dwellSeconds: selectedMission.minDwellSeconds
+        }
+      };
+
+    case "start_verification":
+      if (!state.intent) return state;
+      // create gates from mission requirements
+      {
+        const gates: IGoVerificationGate[] = createVerificationGates(selectedMission);
+        const checking = startAllVerificationGates(gates);
+        const checks = createPresenceChecksFromGates(checking);
+        const score = calculateGateScore(checking);
+        return {
+          ...state,
+          intent: {
+            ...state.intent,
+            status: "verifying",
+            progressPercent: 80,
+            gates: checking,
+            checks,
+            verificationScore: score,
+            rewardStatus: "none"
+          },
+          eventLog: [
+            {
+              id: `evt-${Date.now()}`,
+              type: "verification_started",
+              label: "Verification started",
+              detail: selectedMission.title,
+              createdAtLabel: "Just now"
+            },
+            ...state.eventLog
+          ]
+        };
+      }
+
+    case "pass_verification":
+      if (!state.intent) return state;
+      // pass all gates
+      {
+        const passedGates = passAllVerificationGates(state.intent.gates ?? []);
+        const checks = createPresenceChecksFromGates(passedGates);
+        const score = calculateGateScore(passedGates);
+        return {
+          ...state,
+          intent: {
+            ...state.intent,
+            status: "verifying",
+            gates: passedGates,
+            checks,
+            verificationScore: score,
+            rewardStatus: "pending"
+          },
+          eventLog: [
+            {
+              id: `evt-${Date.now()}`,
+              type: "gate_passed",
+              label: "Verification passed",
+              detail: selectedMission.title,
+              createdAtLabel: "Just now"
+            },
+            {
+              id: `evt2-${Date.now()}`,
+              type: "reward_pending",
+              label: "Reward pending",
+              detail: "Awaiting approval",
+              createdAtLabel: "Just now"
+            },
+            ...state.eventLog
+          ]
+        };
+      }
+
+    case "fail_verification":
+      if (!state.intent) return state;
+      {
+        const failedGates = failFirstVerificationGate(state.intent.gates ?? []);
+        const checks = createPresenceChecksFromGates(failedGates);
+        const score = calculateGateScore(failedGates);
+        const proof = createIGoProofPackage({ mission: selectedMission, intent: state.intent, outcome: "rejected", trustImpact: 0 });
+        const settle = createIGoSettlementContract({ mission: selectedMission, intent: state.intent, proofPackage: proof });
+        return {
+          ...state,
+          intent: {
+            ...state.intent,
+            status: "rejected",
+            gates: failedGates,
+            checks,
+            verificationScore: score,
+            rewardStatus: "rejected"
+          },
+          completion: null,
+          proofPackage: proof,
+          settlementContract: settle,
+          eventLog: [
+            {
+              id: `evt-${Date.now()}`,
+              type: "proof_package_created",
+              label: "Proof package created",
+              detail: selectedMission.title,
+              createdAtLabel: "Just now"
+            },
+            {
+              id: `evt2-${Date.now()}`,
+              type: "gate_failed",
+              label: "Verification failed",
+              detail: selectedMission.title,
+              createdAtLabel: "Just now"
+            },
+            {
+              id: `evt3-${Date.now()}`,
+              type: "reward_rejected",
+              label: "Reward rejected",
+              detail: "Verification failed",
+              createdAtLabel: "Just now"
+            },
+            ...state.eventLog
+          ]
+        };
+      }
+
+    case "send_manual_review":
+      if (!state.intent) return state;
+      {
+        const reviewGates = reviewVerificationGates(state.intent.gates ?? []);
+        const checks = createPresenceChecksFromGates(reviewGates);
+        const score = calculateGateScore(reviewGates);
+        const proof = createIGoProofPackage({ mission: selectedMission, intent: state.intent, outcome: "manual_review", trustImpact: 0 });
+        const settle = createIGoSettlementContract({ mission: selectedMission, intent: state.intent, proofPackage: proof });
+        return {
+          ...state,
+          intent: {
+            ...state.intent,
+            status: "verifying",
+            gates: reviewGates,
+            checks,
+            verificationScore: score,
+            rewardStatus: "manual_review"
+          },
+          proofPackage: proof,
+          settlementContract: settle,
+          eventLog: [
+            {
+              id: `evt-${Date.now()}`,
+              type: "proof_package_created",
+              label: "Proof package created (manual review)",
+              detail: selectedMission.title,
+              createdAtLabel: "Just now"
+            },
+            {
+              id: `evt2-${Date.now()}`,
+              type: "manual_review",
+              label: "Sent for manual review",
+              detail: selectedMission.title,
+              createdAtLabel: "Just now"
+            },
+            ...state.eventLog
+          ]
+        };
+      }
+
+    case "approve_pending_reward":
+      if (!state.intent) return state;
+      {
+        const completion = {
+          intentId: state.intent.id,
+          missionId: selectedMission.id,
+          approved: true,
+          reward: selectedMission.reward,
+          proofId: `igo-proof-${selectedMission.id}`,
+          trustImpact: 0.3,
+          completedAtLabel: "Just now"
+        } as IGoCompletion;
+
+        const proof = createIGoProofPackage({
+          mission: selectedMission,
+          intent: state.intent,
+          outcome: "approved",
+          trustImpact: completion.trustImpact
+        });
+        const settle = createIGoSettlementContract({ mission: selectedMission, intent: state.intent, proofPackage: proof });
+
+        return {
+          ...state,
+          intent: {
+            ...state.intent,
+            status: "completed",
+            rewardStatus: "approved",
+            completedAtLabel: "Just now",
+            progressPercent: 100
+          },
+          completion,
+          proofPackage: proof,
+          settlementContract: settle,
+          eventLog: [
+            {
+              id: `evt-${Date.now()}`,
+              type: "proof_package_created",
+              label: "Proof package created",
+              detail: selectedMission.title,
+              createdAtLabel: "Just now"
+            },
+            {
+              id: `evt2-${Date.now()}`,
+              type: settle.status === "ready" ? "settlement_ready" : "proof_package_created",
+              label: settle.status === "ready" ? "Settlement ready (mock)" : "Settlement pending",
+              detail: settle.settlementNote,
+              createdAtLabel: "Just now"
+            },
+            {
+              id: `evt3-${Date.now()}`,
+              type: "reward_approved",
+              label: "Reward approved",
+              detail: selectedMission.title,
+              createdAtLabel: "Just now"
+            },
+            ...state.eventLog
+          ]
+        };
+      }
+
+    case "reject_pending_reward":
+      if (!state.intent) return state;
+      {
+        const proof = createIGoProofPackage({
+          mission: selectedMission,
+          intent: state.intent,
+          outcome: "rejected",
+          trustImpact: 0
+        });
+        const settle = createIGoSettlementContract({ mission: selectedMission, intent: state.intent, proofPackage: proof });
+        return {
+          ...state,
+          intent: {
+            ...state.intent,
+            status: "rejected",
+            rewardStatus: "rejected"
+          },
+          completion: null,
+          proofPackage: proof,
+          settlementContract: settle,
+          eventLog: [
+            {
+              id: `evt-${Date.now()}`,
+              type: "proof_package_created",
+              label: "Proof package created",
+              detail: selectedMission.title,
+              createdAtLabel: "Just now"
+            },
+            {
+              id: `evt2-${Date.now()}`,
+              type: "reward_rejected",
+              label: "Reward rejected",
+              detail: selectedMission.title,
+              createdAtLabel: "Just now"
+            },
+            ...state.eventLog
+          ]
+        };
+      }
+
+    case "tick_timer":
+      if (!state.intent) return state;
+      if (state.intent.remainingSeconds && state.intent.remainingSeconds > 0) {
+        const rem = state.intent.remainingSeconds - 1;
+        if (rem <= 0) {
+          // expire: create proof + blocked settlement
+          const proof = createIGoProofPackage({ mission: selectedMission, intent: state.intent!, outcome: "expired", trustImpact: 0 });
+          const settle = createIGoSettlementContract({ mission: selectedMission, intent: state.intent!, proofPackage: proof });
+          return {
+            ...state,
+            intent: {
+              ...state.intent,
+              remainingSeconds: 0,
+              status: "expired",
+              rewardStatus: "rejected"
+            },
+            proofPackage: proof,
+            settlementContract: settle,
+            eventLog: [
+              {
+                id: `evt-${Date.now()}`,
+                type: "proof_package_created",
+                label: "Proof package created (expired)",
+                detail: selectedMission.title,
+                createdAtLabel: "Just now"
+              },
+              {
+                id: `evt2-${Date.now()}`,
+                type: "expired",
+                label: "Mission expired",
+                detail: selectedMission.title,
+                createdAtLabel: "Just now"
+              },
+              ...state.eventLog
+            ]
+          };
+        }
+        return {
+          ...state,
+          intent: {
+            ...state.intent,
+            remainingSeconds: rem
+          }
+        };
+      }
+
+    case "reset":
+      return makeInitialState();
+    case "mark_mock_settled":
+      if (!state.settlementContract) return state;
+      if (state.settlementContract.status !== "ready") return state;
+      return {
+        ...state,
+        settlementContract: {
+          ...state.settlementContract,
+          status: "mock_settled"
+        },
+        eventLog: [
+          {
+            id: `evt-${Date.now()}`,
+            type: "mock_settled",
+            label: "Mock settled",
+            detail: state.settlementContract.settlementNote,
+            createdAtLabel: "Just now"
+          },
+          ...state.eventLog
+        ]
+      };
+  }
+}
+
+// Export the reducer and a factory for the initial state for focused unit testing.
+// These exports are intentionally minimal and do not change runtime behavior
+// of the `useIGoState` hook which continues to use the same `reducer` and
+// `initialState` internally.
+export const igoReducer = reducer;
+export function createInitialIGoState(): IGoState {
+  return makeInitialState();
+}
+
+export function useIGoState() {
+  const [state, dispatch] = useReducer(reducer, initialState);
+
+  const selectedMission = useMemo(() => getSelectedMission(state), [state]);
+
+  const progressSteps = useMemo(() => getIGoProgressSteps(state.intent), [state.intent]);
+
+  return {
+    state,
+    selectedMission,
+    progressSteps,
+    selectMission: (missionId: string) => dispatch({ type: "select_mission", missionId }),
+    createIntent: () => dispatch({ type: "create_intent" }),
+    startMission: () => dispatch({ type: "start_mission" }),
+    mockArrival: () => dispatch({ type: "mock_arrival" }),
+    startVerification: () => dispatch({ type: "start_verification" }),
+    passVerification: () => dispatch({ type: "pass_verification" }),
+    failVerification: () => dispatch({ type: "fail_verification" }),
+    sendManualReview: () => dispatch({ type: "send_manual_review" }),
+    approvePendingReward: () => dispatch({ type: "approve_pending_reward" }),
+    rejectPendingReward: () => dispatch({ type: "reject_pending_reward" }),
+    tickTimer: () => dispatch({ type: "tick_timer" }),
+    markMockSettled: () => dispatch({ type: "mark_mock_settled" }),
+    reset: () => dispatch({ type: "reset" })
+  };
+}
+
