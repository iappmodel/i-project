+export const IGoSettlementPanel: React.FC<Props> = ({ settlementContract, onMockSettle }) => {
+  if (!settlementContract) {
+    return (
+      <div className="p-3 bg-gray-900 rounded">
+        <div className="text-sm font-semibold text-white">Mock settlement contract</div>
+        <div className="mt-2 text-xs text-gray-400">No settlement contract yet.</div>
+      </div>
+    );
+  }
