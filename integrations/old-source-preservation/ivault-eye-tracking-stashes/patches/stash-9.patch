index 0000000..a860b54
--- /dev/null
+++ b/src/lib/igo/igo-verification.ts
@@ -0,0 +1,181 @@
+import type {
+  IGoIntent,
+  IGoMission,
+  IGoPresenceCheck,
+  IGoVerificationGate,
+  IGoVerificationGateStatus,
+  IGoEventLogItem,
+  IGoVerificationMethod,
+  IGoProgressStep
+} from "./igo.types";
+
+export function createInitialIntent(mission: IGoMission): IGoIntent {
+  return {
+    id: `igo-intent-${mission.id}`,
+    missionId: mission.id,
+    status: "reserved",
+    declaredAtLabel: "Just now",
+    progressPercent: 20,
+    dwellSeconds: 0,
+    checks: []
+  };
+}
+
+export function getIGoProgressSteps(intent: IGoIntent | null): IGoProgressStep[] {
+  const status = intent?.status ?? "available";
+
+  return [
+    {
+      id: "intent",
+      label: "Intent",
+      state: status === "available" ? "current" : "done"
+    },
+    {
+      id: "travel",
+      label: "Go",
+      state:
+        status === "active"
+          ? "current"
+          : status === "arrived" ||
+              status === "verifying" ||
+              status === "completed"
+          ? "done"
+          : status === "rejected"
+          ? "failed"
+          : "locked"
+    },
+    {
+      id: "arrival",
+      label: "Arrive",
+      state:
+        status === "arrived"
+          ? "current"
+          : status === "verifying" || status === "completed"
+          ? "done"
+          : status === "rejected"
+          ? "failed"
+          : "locked"
+    },
+    {
+      id: "verification",
+      label: "Verify",
+      state:
+        status === "verifying"
+          ? "current"
+          : status === "completed"
+          ? "done"
+          : status === "rejected"
+          ? "failed"
+          : "locked"
+    },
+    {
+      id: "reward",
+      label: "Reward",
+      state:
+        status === "completed" ? "done" : status === "rejected" ? "failed" : "locked"
+    }
+  ];
+}
+
+export function createMockPresenceChecks(mission: IGoMission): IGoPresenceCheck[] {
+  return mission.requirements.map((requirement, index) => ({
+    id: `check-${requirement.id}`,
+    method: requirement.method,
+    label: requirement.label,
+    result: "pass",
+    checkedAtLabel: "Just now",
+    riskScore: Math.max(3, 12 - index * 2)
+  }));
+}
+
+export function calculateVerificationScore(checks: IGoPresenceCheck[]): number {
+  if (checks.length === 0) return 0;
+
+  const passed = checks.filter((check) => check.result === "pass").length;
+  return Math.round((passed / checks.length) * 100);
+}
+
+export function isIGoVerificationApproved(checks: IGoPresenceCheck[]): boolean {
+  return checks.length > 0 && checks.every((check) => check.result === "pass");
+}
+
+// Stage 2 helpers
+export function createVerificationGates(mission: IGoMission): IGoVerificationGate[] {
+  return mission.requirements.map((req, idx) => ({
+    id: `gate-${req.id}`,
+    method: req.method,
+    label: req.label,
+    detail: req.detail,
+    required: req.required,
+    status: idx === 0 ? "ready" : "locked",
+  }));
+}
+
+export function startAllVerificationGates(gates: IGoVerificationGate[]): IGoVerificationGate[] {
+  return gates.map((g) =>
+    g.required ? { ...g, status: "checking" } : { ...g }
+  );
+}
+
+export function passAllVerificationGates(gates: IGoVerificationGate[]): IGoVerificationGate[] {
+  return gates.map((g) =>
+    g.required && (g.status === "checking" || g.status === "ready")
+      ? { ...g, status: "passed", checkedAtLabel: "Just now", riskScore: 12 }
+      : g
+  );
+}
+
+export function failFirstVerificationGate(gates: IGoVerificationGate[]): IGoVerificationGate[] {
+  const out = gates.map((g) => ({ ...g }));
+  const idx = out.findIndex((g) => g.required && (g.status === "checking" || g.status === "ready"));
+  if (idx >= 0) {
+    out[idx].status = "failed";
+    out[idx].checkedAtLabel = "Just now";
+    out[idx].riskScore = 87;
+    // later gates remain locked
+  }
+  return out;
+}
+
+export function reviewVerificationGates(gates: IGoVerificationGate[]): IGoVerificationGate[] {
+  return gates.map((g) =>
+    g.required && (g.status === "checking" || g.status === "ready")
+      ? { ...g, status: "review", checkedAtLabel: "Just now", riskScore: 54 }
+      : g
+  );
+}
+
+export function calculateGateScore(gates: IGoVerificationGate[]): number {
+  if (gates.length === 0) return 0;
+  let score = 0;
+  gates.forEach((g) => {
+    if (g.status === "passed") score += 100;
+    else if (g.status === "review") score += 60;
+    else if (g.status === "failed") score += 0;
+    else if (g.status === "checking" || g.status === "ready") score += 30;
+  });
+  const avg = Math.round(score / gates.length);
+  return Math.max(0, Math.min(100, avg));
+}
+
+export function createPresenceChecksFromGates(gates: IGoVerificationGate[]): IGoPresenceCheck[] {
+  return gates.map((g) => {
+    const map: Record<string, any> = {
+      passed: "pass",
+      failed: "fail",
+      review: "manual_review",
+      checking: "pending",
+      ready: "pending",
+      locked: "pending",
+    };
+    return {
+      id: `check-${g.id}`,
+      method: g.method as IGoVerificationMethod,
+      label: g.label,
+      result: map[g.status] as any,
+      checkedAtLabel: g.checkedAtLabel,
+      riskScore: g.riskScore,
+    };
+  });
+}
+
