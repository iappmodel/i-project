{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true
  },
  "include": [
    "aggregation/**/*.ts",
    "constants/**/*.ts",
    "copy/pops-copy-reviewer.ts",
    "demo/PopsSponsoredWatchDemo.tsx",
    "demo/PopsDemoDebugPanel.tsx",
    "demo/PopsDemoRewardLedger.tsx",
    "css-modules.d.ts",
    "demo/usePopsDemoLedger.ts",
    "demo/pops-demo-scenarios.ts",
    "demo/pops-demo-ledger.types.ts",
    "events/**/*.ts",
    "hooks/usePopsSession.ts",
    "normalization/**/*.ts",
    "orchestrator/**/*.ts",
    "preview/**/*.ts",
    "privacy/pops-privacy-copy.ts",
    "privacy/pops-privacy-receipt.service.ts",
    "rewards/pops-reward-decision.service.ts",
    "rewards/pops-reward-formula.ts",
    "rewards/pops-wallet-integration.ts",
    "scoring/**/*.ts",
    "storage/**/*.ts",
    "types/pops-decisions.types.ts",
    "types/pops-events.types.ts",
    "types/pops-privacy.types.ts",
    "types/pops.types.ts",
    "ui/PopsProofLevelBadge.tsx",
    "ui/PopsMomentVerified.tsx",
    "ui/PopsPrivacyReceiptCard.tsx",
    "ui/PopsRewardProgress.tsx",
    "ui/PopsStatusChip.tsx",
    "utils/**/*.ts"
  ],
  "exclude": ["**/*.test.ts", "**/*.test.tsx"]
}
