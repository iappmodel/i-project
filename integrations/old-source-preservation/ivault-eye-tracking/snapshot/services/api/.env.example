SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

API_PORT=3000
NODE_ENV=development

WORKER_API_SECRET=

ADMIN_ALERT_EMAIL_PROVIDER=manual_demo
ADMIN_ALERT_EMAIL_DRY_RUN=true
ADMIN_ALERT_EMAIL_FROM=security@yourdomain.com
ADMIN_ALERT_EMAIL_ALLOWED_RECIPIENTS=security@example.com,ops@example.com
ADMIN_ALERT_EMAIL_ALLOWED_DOMAINS=yourdomain.com
ADMIN_ALERT_EMAIL_HTTP_ENDPOINT=
ADMIN_ALERT_EMAIL_HTTP_API_KEY=
ADMIN_ALERT_EMAIL_HTTP_PROVIDER_KEY=generic_email_http

ADMIN_ALERT_SLACK_PROVIDER=manual_demo
ADMIN_ALERT_SLACK_DRY_RUN=true
ADMIN_ALERT_SLACK_ALLOWED_CHANNEL_KEYS=security_alerts,admin_alerts
ADMIN_ALERT_SLACK_WEBHOOK_SECURITY_ALERTS=
ADMIN_ALERT_SLACK_WEBHOOK_ADMIN_ALERTS=

ADMIN_ALERT_WEBHOOK_ALLOWED_HOSTS=hooks.yourdomain.com,alerts.yourdomain.com
ADMIN_ALERT_WEBHOOK_SECRET=
ADMIN_ALERT_WEBHOOK_TIMEOUT_MS=5000

# Admin console: Supabase Auth user with rows in admin_users + admin_user_roles (see migration 125).
ADMIN_USER_EMAIL=
ADMIN_USER_PASSWORD=
ADMIN_MFA_TOTP_ISSUER=i Admin
ADMIN_MFA_ENCRYPTION_KEY_BASE64=
ADMIN_MFA_TOTP_ALLOWED_WINDOW=1

