+function WatchVerify({ requiredSec, progress, attentionScore, onProgress, onComplete }: { requiredSec: number; progress: number; attentionScore: number; onProgress: (p: number, score: number) => void; onComplete: () => void }) {
+  // simulate progress when component mounts
+  React.useEffect(() => {
+    let raf = 0
+    const start = performance.now()
+    let p = progress
+    let score = attentionScore
+    function step(t: number) {
+      const elapsed = (t - start) / 1000
+      const total = requiredSec
+      p = Math.min(1, elapsed / total)
+      // simulate attention score wiggle
+      score = Math.max(40, Math.min(99, score + (Math.sin(t / 400) * 2)))
+      onProgress(p, Math.round(score))
+      if (p < 1) raf = requestAnimationFrame(step)
+    }
+    raf = requestAnimationFrame(step)
+    return () => cancelAnimationFrame(raf)
+  }, [requiredSec, attentionScore, onProgress, progress])
+
+  return (
+    <section className="card watch-verify">
+      <h2>Watching — reward locked</h2>
+      <div className="watch-body">
