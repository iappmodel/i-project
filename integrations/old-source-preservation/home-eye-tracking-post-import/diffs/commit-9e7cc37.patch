+function VerificationResult({ attentionScore, watchSec, requiredSec, onSuccess, onFail }: { attentionScore: number; watchSec: number; requiredSec: number; onSuccess: () => void; onFail: () => void }) {
+  // deterministic gates
+  const gates = [
+    { id: "presence", label: "presence detected", pass: true },
+    { id: "time", label: "required watch time met", pass: watchSec >= requiredSec },
+    { id: "attention", label: "attention score passed", pass: attentionScore >= 60 },
+    { id: "completion", label: "completion received", pass: true },
+    { id: "fraud", label: "fraud flags clean", pass: attentionScore < 95 },
+  ]
+  const allPass = gates.every((g) => g.pass)
+  return (
+    <section className="card verification-result">
+      <h2>Verification Result</h2>
+      <ul className="gates">
+        {gates.map((g) => (
+          <li key={g.id} className={g.pass ? "pass" : "fail"}>
+            <span className="dot">{g.pass ? "✓" : "✕"}</span>
+            <div className="gate-meta">
+              <div className="gate-label">{g.label}</div>
+            </div>
+          </li>
+        ))}
+      </ul>
