+              <div className="timeline-text">{Math.round(progress * 100)}% · {Math.round(progress * requiredSec)}s / {requiredSec}s</div>
+            </div>
+          </div>
+        </div>
+        <div className="actions">
+          <button className="primary" onClick={onComplete}>Complete & Verify</button>
+        </div>
+      </div>
+    </section>
+  )
+}
