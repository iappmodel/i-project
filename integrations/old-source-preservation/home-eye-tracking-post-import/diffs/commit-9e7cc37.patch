+function AttentionRing({ score }: { score: number }) {
+  const pct = Math.max(0, Math.min(100, score))
+  const radius = 44
+  const circ = 2 * Math.PI * radius
+  const dash = (pct / 100) * circ
+  const color =
+    pct >= 80 ? "#32d583" : pct >= 60 ? "#1dd3c6" : pct >= 45 ? "#ffd166" : "#ff8a65"
+  return (
+    <svg width={110} height={110} viewBox="0 0 110 110" className="attention-ring">
+      <defs>
+        <filter id="glow">
+          <feGaussianBlur stdDeviation="3" result="b" />
+          <feMerge>
+            <feMergeNode in="b" />
+            <feMergeNode in="SourceGraphic" />
+          </feMerge>
+        </filter>
+      </defs>
+      <g transform="translate(55,55)">
+        <circle r={radius} fill="#0f1113" stroke="#2b2d33" strokeWidth="10" />
+        <circle
+          r={radius}
+          fill="transparent"
+          stroke={color}
+          strokeWidth={8}
+          strokeLinecap="round"
+          strokeDasharray={`${dash} ${circ - dash}`}
+          strokeDashoffset={circ * 0.25}
+          transform="rotate(-90)"
+          style={{ filter: "url(#glow)" }}
+        />
+        <text x="0" y="6" textAnchor="middle" fill="#e6edf0" fontSize="20" fontFamily="monospace">{score}</text>
+      </g>
+    </svg>
+  )
+}
